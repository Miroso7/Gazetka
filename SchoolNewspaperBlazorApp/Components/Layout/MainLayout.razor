@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.WebUtilities
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Service
@inject NotificationService Notify
@inject NavigationManager Navigation

<a class="skip-link" href="#main" onclick="var m=document.getElementById('main'); if(m){m.focus(); m.scrollIntoView();} return false;">Przejdź do treści</a>

<header class="site-header" data-enhance-nav="false">
    <div class="container site-nav">

        <a class="site-nav__brand" href="/" aria-label="Gazetka szkolna – strona główna">
            <img class="site-nav__logo"
                 src="/logo.png"
                 alt="Gazetka szkolna"
                 decoding="async"
                 fetchpriority="high" />
        </a>

        <input type="checkbox" id="nav-toggle" class="site-nav__check" aria-label="Przełącz menu" />
        <label for="nav-toggle" class="site-nav__burger" aria-hidden="true"><span></span></label>

        <div class="site-nav__panel">
            <div class="site-nav__panel-inner">

                <nav class="site-nav__links" aria-label="Główna nawigacja">
                    <a class="nav-link @(IsHomeActive ? "active" : "")" href="/"
                       aria-current="@(IsHomeActive ? "page" : null)">Strona główna</a>
                    @* Nowości, Wydarzenia i Ogłoszenia to zakładki strony głównej (/?typ=...), nie osobne podstrony *@
                    @foreach (var tab in navTypes)
                    {
                        var isActive = ActiveType == tab;
                        <a class="nav-link @(isActive ? "active" : "")" href="@TabHref(tab)"
                           aria-current="@(isActive ? "page" : null)">@tab.Label()</a>
                    }
                    <NavLink class="nav-link" href="/zastepstwa">Zastępstwa</NavLink>
                    <AuthorizeView>
                        <NavLink class="nav-link" href="/adminPanel">Admin Panel</NavLink>
                    </AuthorizeView>
                </nav>

                <div class="site-nav__actions">
                    @* na /zastepstwa szukamy w zastępstwach, gdzie indziej w artykułach na stronie głównej (/?q=fraza);
                       bez działającego obwodu Blazora formularz wysyła zwykłe żądanie GET *@
                    <form class="site-nav__search" role="search" method="get" action="@SearchAction" @onsubmit="SubmitSearch">
                        <input class="site-nav__search-input"
                               name="q"
                               type="search"
                               @bind="searchText"
                               @bind:event="oninput"
                               maxlength="100"
                               autocomplete="off"
                               enterkeyhint="search"
                               placeholder="@SearchPlaceholder"
                               aria-label="@SearchPlaceholder" />
                        <button class="site-nav__search-btn" type="submit" aria-label="Szukaj">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7" />
                                <path d="M20 20l-3.5-3.5" />
                            </svg>
                        </button>
                    </form>

                    <AuthorizeView>
                        <Authorized>
                            <form method="post" action="/auth/logout" class="site-nav__logout">
                                <AntiforgeryToken />
                                <button type="submit" class="nav-link nav-link--cta">Wyloguj</button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink class="nav-link nav-link--cta" href="/login">Logowanie</NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>

            </div>
        </div>

    </div>

    <div class="notify-wrap" aria-live="polite">
        @if (message is not null)
        {
            <div class="notify notify--@type.ToString().ToLower()" role="status" @key="counter">
                <span>@message</span>
            </div>
        }
    </div>
</header>

<main id="main" class="container py-4" tabindex="-1">
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <div class="site-footer__about">
                <span class="site-footer__brand">Gazetka szkolna</span>
                <p>Aktualności, wydarzenia i artykuły uczniów Technikum Informatycznego, w jednym miejscu.</p>
                <div class="site-footer__made">
                    <span class="site-footer__made-text">
                        <strong>Wykonana przez uczniów</strong>
                        <small>Technikum Informatycznego</small>
                    </span>
                </div>
            </div>

            <nav class="site-footer__col" aria-label="Nawigacja w stopce">
                <span class="site-footer__heading">Na skróty</span>
                <a href="/">Strona główna</a>
                @foreach (var tab in navTypes)
                {
                    <a href="@TabHref(tab)">@tab.Label()</a>
                }
                <a href="/zastepstwa">Zastępstwa</a>
            </nav>

            <nav class="site-footer__col" aria-label="Konto">
                <span class="site-footer__heading">Dla redakcji</span>
                <AuthorizeView>
                    <Authorized>
                        <a href="/adminPanel">Admin Panel</a>
                        <form method="post" action="/auth/logout" class="site-footer__form">
                            <AntiforgeryToken />
                            <button type="submit" class="site-footer__link">Wyloguj</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login">Logowanie</a>
                    </NotAuthorized>
                </AuthorizeView>
            </nav>
        </div>

        <div class="site-footer__bottom">
            <span>© @DateTime.Now.Year Technikum Informatyczne. Wszelkie prawa zastrzeżone.</span>
            <button type="button" class="site-footer__top-btn"
                    aria-label="Wróć na górę" title="Wróć na górę"
                    onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 19V5M5 12l7-7 7 7" />
                </svg>
            </button>
        </div>
    </div>

</footer>

@code {
    private string? message;
    private NotificationType type;
    private int counter;
    private CancellationTokenSource? cts;

    // zakładki strony głównej linkowane z nagłówka i stopki
    private static readonly ArticleType[] navTypes = { ArticleType.News, ArticleType.Events, ArticleType.Announcements };

    private static string TabHref(ArticleType type) => $"/?typ={type}#aktualnosci";

    // zakładka wybrana w adresie (/?typ=Events) – tak samo jak na stronie głównej; null = brak lub nieznana
    private ArticleType? ActiveType
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            if (uri.AbsolutePath != "/") return null;

            var query = QueryHelpers.ParseQuery(uri.Query);
            return query.TryGetValue("typ", out var value)
                && Enum.TryParse<ArticleType>(value.ToString(), true, out var type)
                && Array.IndexOf(navTypes, type) >= 0
                    ? type
                    : null;
        }
    }

    // pole wyszukiwania: na /zastepstwa szuka w zastępstwach, na pozostałych stronach w artykułach strony głównej
    private string searchText = "";

    private bool OnSubstitutions =>
        string.Equals(new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/'), "/zastepstwa", StringComparison.OrdinalIgnoreCase);

    private string SearchAction => OnSubstitutions ? "/zastepstwa" : "/#aktualnosci";

    private string SearchPlaceholder => OnSubstitutions ? "Szukaj zastępstw..." : "Szukaj...";

    // fraza z adresu (/?q=... lub /zastepstwa?q=...) wraca do pola wyszukiwania w nagłówku
    private string SearchQuery
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            if (uri.AbsolutePath != "/" && !OnSubstitutions) return "";

            return QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var value)
                ? value.ToString().Trim()
                : "";
        }
    }

    private void SubmitSearch()
    {
        var term = searchText.Trim();
        var query = term.Length > 0 ? $"?q={Uri.EscapeDataString(term)}" : "";

        Navigation.NavigateTo(OnSubstitutions ? $"/zastepstwa{query}" : $"/{query}#aktualnosci");
    }

    // „Strona główna” świeci tylko wtedy, gdy nie jest wybrana żadna z zakładek w menu
    private bool IsHomeActive => new Uri(Navigation.Uri).AbsolutePath == "/" && ActiveType is null;

    protected override void OnInitialized()
    {
        Notify.OnShow += HandleShow;
        Navigation.LocationChanged += HandleLocationChanged;
        searchText = SearchQuery;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        searchText = SearchQuery;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleShow(string text, NotificationType t)
    {
        cts?.Cancel();
        cts = new CancellationTokenSource();

        message = text;
        type = t;
        counter++;   // nowy @key = animacja startuje od nowa przy kolejnym powiadomieniu

        _ = InvokeAsync(StateHasChanged);
        _ = HideAfterAsync(cts.Token);
    }

    private async Task HideAfterAsync(CancellationToken token)
    {
        try { await Task.Delay(3000, token); }
        catch (OperationCanceledException) { return; }

        message = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Notify.OnShow -= HandleShow;
        Navigation.LocationChanged -= HandleLocationChanged;
        cts?.Cancel();
        cts?.Dispose();
    }
}
