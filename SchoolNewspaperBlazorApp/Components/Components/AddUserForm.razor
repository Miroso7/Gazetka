@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components

@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service

<div class="add-article-form">
    <h1 class="add-article-form__title">Dodaj użytkownika</h1>

    <form @onsubmit="AddUserAsync" @onsubmit:preventDefault>
        <label class="form-label">Imię</label>
        <input @bind="FirstName" class="form-control mb-3" placeholder="Imię" />

        <label class="form-label">Nazwisko</label>
        <input @bind="LastName" class="form-control mb-3" placeholder="Nazwisko" />

        <label class="form-label">E-mail</label>
        <input @bind="Email" type="email" class="form-control mb-3" placeholder="E-Mail" />

        <label class="form-label">Rola</label>
        <select @bind="Role" class="form-select mb-3">
            @foreach (var option in Enum.GetValues<UserRole>())
            {
                <option value="@option">@option.Label()</option>
            }
        </select>

        <label class="form-label">Hasło</label>
        <input @bind="Password" type="password" class="form-control mb-4" placeholder="Hasło" />

        <button type="submit" class="btn btn-primary w-100">Dodaj</button>
    </form>
</div>

@code {

    public string FirstName { get; set; } = string.Empty;
    public string LastName { get; set; } = string.Empty;
    public string Password { get; set; } = string.Empty;
    public string Email { get; set; } = string.Empty;
    public UserRole Role { get; set; } = UserRole.Student;

    [Inject]
    public IAuthService AuthService { get; set; } = default!;

    [Inject]
    public NotificationService Notify { get; set; } = default!;

    public async Task AddUserAsync()
    {
        try
        {
            await AuthService.AddUserAsync(FirstName, LastName, Password, Email, Role);
            FirstName = LastName = Password = Email = string.Empty;
            Notify.Show("Dodano użytkownika.");
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            Notify.Show(ex.Message, NotificationType.Error);
        }
    }

}
