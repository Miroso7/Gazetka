@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components

@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service

<div class="add-article-form">
    <h1 class="add-article-form__title">Dodaj użytkownika</h1>

    <form @onsubmit="AddUserAsync" @onsubmit:preventDefault>
        <label class="form-label">Login</label>
        <input @bind="Login" class="form-control mb-3" placeholder="Login" />

        <label class="form-label">E-mail</label>
        <input @bind="Email" type="email" class="form-control mb-3" placeholder="E-Mail" />

        <label class="form-label">Hasło</label>
        <input @bind="Password" type="password" class="form-control mb-4" placeholder="Hasło" />

        <button type="submit" class="btn btn-primary w-100">Dodaj</button>
    </form>
</div>

@code {

    public required string Login { get; set; }
    public required string Password { get; set; }
    public required string Email { get; set; }

    [Inject]
    public IAuthService AuthService { get; set; } = default!;

    [Inject]
    public NotificationService Notify { get; set; } = default!;

    public async Task AddUserAsync()
    {
        try
        {
            await AuthService.AddUserAsync(Login, Password, Email);
            Login = Password = Email = string.Empty;
            Notify.Show("Dodano użytkownika.");
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            Notify.Show(ex.Message, NotificationType.Error);
        }
    }

}
