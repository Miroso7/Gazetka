@using SchoolNewspaperBlazorApp.Data
@using Microsoft.Extensions.Logging
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject ISubstitutionService SubstitutionService
@inject ISchoolDataService SchoolDataService
@inject ILogger<SubstitutionForm> Logger

<div class="add-article-form subst-form">
    <h2 class="add-article-form__title">@(Edited is null ? "Dodaj zastępstwo" : "Edytuj zastępstwo")</h2>

    @if (loading)
    {
        <div class="skel-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
    }
    else
    {
        if (classes.Count == 0 || teachers.Count < 2)
        {
            <div class="form-alert" role="status">
                Brakuje danych do wyboru: potrzebna jest co najmniej jedna klasa i dwóch nauczycieli.
                Uzupełnij je w zakładce „Dane szkoły”.
            </div>
        }

        if (error != null)
        {
            <div class="auth-alert" role="alert">@error</div>
        }

        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="subst-form__grid">
                <div>
                    <label class="form-label" for="subst-date">Dzień</label>
                    <input id="subst-date" type="date" @bind="model.Date" class="form-control" />
                </div>

                <div>
                    <label class="form-label" for="subst-lesson">Lekcja</label>
                    <select id="subst-lesson" @bind="model.Lesson" class="form-select mb-3">
                        @for (var i = 1; i <= Substitution.MaxLesson; i++)
                        {
                            <option value="@i">@(i). lekcja</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" for="subst-class">Klasa</label>
                    <select id="subst-class" @bind="model.ClassId" class="form-select mb-3">
                        <option value="">Wybierz klasę</option>
                        @foreach (var c in classes)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" for="subst-subject">Przedmiot</label>
                    <select id="subst-subject" @bind="model.SubjectId" class="form-select mb-3">
                        <option value="">Bez przedmiotu</option>
                        @foreach (var s in subjects)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" for="subst-absent">Nieobecny nauczyciel</label>
                    <select id="subst-absent" @bind="model.AbsentTeacherId" class="form-select mb-3">
                        <option value="">Wybierz nauczyciela</option>
                        @foreach (var t in teachers)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" for="subst-substitute">Zastępujący nauczyciel</label>
                    <select id="subst-substitute" @bind="model.SubstituteTeacherId" class="form-select mb-3" disabled="@model.IsCancelled">
                        <option value="">Wybierz nauczyciela</option>
                        @foreach (var t in teachers.Where(t => t.Id != model.AbsentTeacherId))
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" for="subst-room">Sala</label>
                    <select id="subst-room" @bind="model.RoomId" class="form-select mb-3">
                        <option value="">Bez sali</option>
                        @foreach (var r in rooms)
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    </select>
                </div>

                <div class="subst-form__check">
                    <label class="perm-chip @(model.IsCancelled ? "is-on" : "")">
                        <input type="checkbox" @bind="model.IsCancelled" />
                        <span>Lekcja odwołana (bez zastępstwa)</span>
                    </label>
                </div>
            </div>

            <label class="form-label" for="subst-note">Uwagi</label>
            <textarea id="subst-note" @bind="model.Note" class="form-control" rows="2"
                      maxlength="@Substitution.MaxNoteLength" placeholder="Opcjonalnie, np. zbiórka przed salą"></textarea>

            <div class="subst-form__actions">
                @if (OnCancelled.HasDelegate)
                {
                    <button type="button" class="btn btn-outline-primary" @onclick="() => OnCancelled.InvokeAsync()" disabled="@saving">Anuluj</button>
                }
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @(saving ? "Zapisywanie..." : Edited is null ? "Dodaj zastępstwo" : "Zapisz zmiany")
                </button>
            </div>
        </form>
    }
</div>

@code {
    // zastępstwo do edycji (null = nowe)
    [Parameter]
    public Substitution? Edited { get; set; }

    // dzień wstawiany do nowego zastępstwa
    [Parameter]
    public DateTime DefaultDate { get; set; } = DateTime.Today;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private SubstitutionInput model = new();
    private List<SchoolDictionaryItem> classes = new();
    private List<SchoolDictionaryItem> teachers = new();
    private List<SchoolDictionaryItem> rooms = new();
    private List<SchoolDictionaryItem> subjects = new();
    private bool loading = true;
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        model = Edited is null
            ? new SubstitutionInput { Date = DefaultDate.Date }
            : SubstitutionInput.From(Edited);

        try
        {
            classes = await SchoolDataService.GetItemsAsync(SchoolDictionaryKind.Class);
            teachers = await SchoolDataService.GetItemsAsync(SchoolDictionaryKind.Teacher);
            rooms = await SchoolDataService.GetItemsAsync(SchoolDictionaryKind.Room);
            subjects = await SchoolDataService.GetItemsAsync(SchoolDictionaryKind.Subject);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się wczytać słowników do formularza zastępstwa.");
            error = "Nie udało się wczytać list wyboru. Odśwież stronę.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            if (model.IsCancelled)
            {
                model.SubstituteTeacherId = null;
            }

            var wasNew = Edited is null;
            if (wasNew)
            {
                await SubstitutionService.AddSubstitutionAsync(model);
            }
            else
            {
                await SubstitutionService.UpdateSubstitutionAsync(model);
            }

            if (wasNew)
            {
                // kolejne zastępstwo zwykle dotyczy tego samego dnia i nauczyciela, więc zostają w formularzu
                model = new SubstitutionInput { Date = model.Date, AbsentTeacherId = model.AbsentTeacherId };
            }
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się zapisać zastępstwa.");
            error = "Nie udało się zapisać zastępstwa. Spróbuj ponownie.";
        }
        finally
        {
            saving = false;
        }
    }
}
