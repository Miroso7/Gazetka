@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService
@inject IFileService fileService
@inject IPermissionService permissionService

<div class="add-article-form">
    <h1 class="add-article-form__title">@(IsEditing ? "Edytuj artykuł" : "Dodaj artykuł")</h1>

    @if (added)
    {
        <div class="form-alert" role="status">Artykuł został dodany.</div>
    }

    @if (errorMessage != null)
    {
        <div class="auth-alert" role="alert">@errorMessage</div>
    }

    @if (previewImage != null)
    {
        <div class="image-preview">
            <img src="@previewImage" alt="zdjęcie" />
        </div>
    }

    <label class="form-label">@(IsEditing ? "Zdjęcie * (wybierz nowe, aby je zmienić)" : "Zdjęcie *")</label>
    <InputFile @key="fileInputKey" OnChange="ChoosePhoto" accept="image/*" class="form-control mb-3" />

    <form @onsubmit="SaveArticle" @onsubmit:preventDefault>
        <label class="form-label">Kategoria *</label>
        <select @bind="type" class="form-select mb-3">
            @foreach (var option in Enum.GetValues<ArticleType>())
            {
                <option value="@option">@option.Label()</option>
            }
        </select>

        <label class="form-label">Tytuł *</label>
        <input @bind="title" class="form-control mb-3" placeholder="Wpisz tytuł..." />

        <label class="form-label">Treść *</label>
        <textarea @bind="text" class="form-control mb-3" rows="6" placeholder="Treść artykułu..."></textarea>

        <label class="form-label">Autor</label>
        <input @bind="author" class="form-control mb-4" placeholder="Imię i nazwisko" />

        <label class="form-label">Galeria zdjęć (opcjonalnie)</label>
        @if (GalleryCount > 0)
        {
            <ul class="gallery-edit">
                @foreach (var photo in existingPhotos)
                {
                    <li @key="photo" class="gallery-edit__item">
                        <img src="@photo.Url" alt="Zdjęcie z galerii" loading="lazy" decoding="async" />
                        <button type="button" class="gallery-edit__remove" @onclick="() => RemoveExistingPhoto(photo)"
                                aria-label="Usuń zdjęcie z galerii" title="Usuń zdjęcie">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
                        </button>
                    </li>
                }
                @foreach (var photo in stagedPhotos)
                {
                    <li @key="photo" class="gallery-edit__item">
                        <img src="@photo.Preview" alt="Nowe zdjęcie do galerii" decoding="async" />
                        <span class="gallery-edit__badge">Nowe</span>
                        <button type="button" class="gallery-edit__remove" @onclick="() => RemoveStagedPhoto(photo)"
                                aria-label="Usuń zdjęcie z galerii" title="Usuń zdjęcie">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
                        </button>
                    </li>
                }
            </ul>
        }
        <InputFile @key="galleryInputKey" OnChange="ChooseGalleryPhotos" multiple accept="image/*"
                   disabled="@GalleryFull" class="form-control gallery-edit__input mb-1" />
        <div class="form-text gallery-edit__hint mb-4">
            Zdjęcia w galerii: @GalleryCount / @IArticleService.MaxGalleryImages (JPG, PNG, GIF lub WebP, do 5 MB każde).
            Zmiany zapiszą się po kliknięciu „@(IsEditing ? "Zapisz zmiany" : "Dodaj")”.
        </div>

        <button type="submit" class="btn btn-primary w-100">@(IsEditing ? "Zapisz zmiany" : "Dodaj")</button>
        @if (IsEditing)
        {
            <button type="button" class="btn btn-outline-primary w-100 mt-2" @onclick="Cancel">Anuluj</button>
        }
    </form>
</div>

@code {
    private string title = "";
    private string text = "";
    private string author = "";
    private ArticleType type = ArticleType.News;
    private string? previewImage;
    private bool added;
    private string? errorMessage;
    private int fileInputKey;

    private int loadedArticleId;
    private int existingFileId;

    // galeria: zdjęcia już zapisane w artykule oraz nowe, czekające na zapis (trzymamy je w pamięci,
    // bo przeglądarka pozwala odczytać plik tylko zaraz po wybraniu)
    private const long MaxPhotoBytes = 5 * 1024 * 1024;
    private readonly List<ArticleImageDto> existingPhotos = new();
    private readonly List<StagedPhoto> stagedPhotos = new();
    private readonly List<int> removedImageIds = new();
    private int galleryInputKey;

    private class StagedPhoto
    {
        public required byte[] Bytes { get; init; }
        public required string Preview { get; init; }
    }

    private int GalleryCount => existingPhotos.Count + stagedPhotos.Count;
    private bool GalleryFull => GalleryCount >= IArticleService.MaxGalleryImages;

    // gdy ustawiony, formularz działa w trybie edycji tego artykułu
    [Parameter]
    public Article? ArticleToEdit { get; set; }
    [Parameter]
    public EventCallback OnAdded { get; set; }
    [Parameter]
    public EventCallback OnEdited { get; set; }
    [Parameter]
    public EventCallback OnCancelled { get; set; }

    IBrowserFile? file;

    private bool IsEditing => ArticleToEdit != null;

    protected override async Task OnParametersSetAsync()
    {
        if (ArticleToEdit is null || loadedArticleId == ArticleToEdit.Id) return;

        loadedArticleId = ArticleToEdit.Id;
        title = ArticleToEdit.Title ?? "";
        text = ArticleToEdit.Text ?? "";
        author = ArticleToEdit.Author ?? "";
        type = ArticleToEdit.Type;
        existingFileId = ArticleToEdit.FileId;
        previewImage = null;

        try
        {
            var fileName = await fileService.GetFileNameByIdAsync(existingFileId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                previewImage = $"/Images/{fileName}";
            }
        }
        catch (Exception) { }

        existingPhotos.Clear();
        stagedPhotos.Clear();
        removedImageIds.Clear();
        try
        {
            existingPhotos.AddRange(await articleService.GetArticleImagesAsync(ArticleToEdit.Id));
        }
        catch (Exception) { }
    }

    private async Task ChooseGalleryPhotos(InputFileChangeEventArgs e)
    {
        added = false;
        errorMessage = null;

        IReadOnlyList<IBrowserFile> picked;
        try
        {
            picked = e.GetMultipleFiles(IArticleService.MaxGalleryImages);
        }
        catch (InvalidOperationException)
        {
            errorMessage = $"Naraz można wybrać maksymalnie {IArticleService.MaxGalleryImages} zdjęć.";
            galleryInputKey++;
            return;
        }

        var skipped = 0;
        foreach (var picture in picked)
        {
            if (GalleryFull)
            {
                skipped++;
                continue;
            }

            try
            {
                if (picture.Size > MaxPhotoBytes) { skipped++; continue; }

                using var stream = picture.OpenReadStream(MaxPhotoBytes);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                var bytes = memory.ToArray();

                // zawartość musi być zdjęciem (serwer sprawdza to jeszcze raz przy zapisie)
                if (!fileService.IsSupportedImage(bytes)) { skipped++; continue; }

                // mała miniatura robiona w przeglądarce, żeby nie wysyłać pełnych zdjęć do podglądu
                var thumbnail = await picture.RequestImageFileAsync("image/jpeg", 480, 480);
                using var thumbStream = thumbnail.OpenReadStream(1024 * 1024);
                using var thumbMemory = new MemoryStream();
                await thumbStream.CopyToAsync(thumbMemory);

                stagedPhotos.Add(new StagedPhoto
                {
                    Bytes = bytes,
                    Preview = $"data:image/jpeg;base64,{Convert.ToBase64String(thumbMemory.ToArray())}"
                });
            }
            catch (Exception)
            {
                skipped++;
            }
        }

        if (skipped > 0)
        {
            errorMessage = $"Pominięto zdjęcia: {skipped} (dozwolone JPG, PNG, GIF lub WebP do 5 MB, limit galerii: {IArticleService.MaxGalleryImages}).";
        }
        galleryInputKey++; // czyści pole wyboru, żeby można było dodać kolejne zdjęcia
    }

    private void RemoveExistingPhoto(ArticleImageDto photo)
    {
        existingPhotos.Remove(photo);
        removedImageIds.Add(photo.Id);
    }

    private void RemoveStagedPhoto(StagedPhoto photo)
    {
        stagedPhotos.Remove(photo);
    }

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);
        added = false;
        errorMessage = null;
    }

    private async Task SaveArticle()
    {
        try
        {
            await SaveArticleCore();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SaveArticleCore()
    {
        // sprawdzamy permisję zanim cokolwiek wgramy (zdjęcie trafia na dysk jeszcze przed zapisem artykułu)
        var needed = IsEditing ? EnumPermissions.EditArticle : EnumPermissions.AddArticle;
        if (!await permissionService.HasPermissionAsync(needed))
        {
            errorMessage = IsEditing
                ? "Nie masz uprawnienia do edycji artykułów."
                : "Nie masz uprawnienia do dodawania artykułów.";
            return;
        }

        // tytuł i treść są wymagane (autor jest opcjonalny); sprawdzamy to przed wgraniem zdjęcia
        added = false;
        if (string.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Podaj tytuł artykułu.";
            return;
        }
        if (string.IsNullOrWhiteSpace(text))
        {
            errorMessage = "Podaj treść artykułu.";
            return;
        }

        // zdjęcie jest wymagane: przy dodawaniu trzeba wybrać plik,
        // przy edycji wystarczy dotychczasowe zdjęcie albo nowe
        var hasPhoto = file != null || (IsEditing && existingFileId > 0);
        if (!hasPhoto)
        {
            errorMessage = "Dodaj zdjęcie do artykułu.";
            return;
        }
        errorMessage = null;

        // zdjęcia do galerii wgrywamy dopiero przy zapisie (wszystkie albo żadne)
        var galleryFileIds = stagedPhotos.Count > 0
            ? await fileService.UploadImages(stagedPhotos.Select(p => p.Bytes).ToList())
            : new List<int>();

        if (IsEditing) 
        {
            // bez nowego zdjęcia zostaje dotychczasowe
            int fileId = existingFileId;
            if (file != null)
            {
                fileId = await fileService.UploadImage(file);
            }
            await articleService.UpdateArticleAsync(ArticleToEdit!.Id, title, text, author, type, fileId, galleryFileIds, removedImageIds);
            file = null;
            await OnEdited.InvokeAsync();
            return;
        }

        int id = 0;
        if (file != null)
        {
            id = await fileService.UploadImage(file);
        }
        await articleService.AddArticleAsync(title, text, author, type, id, galleryFileIds);
        title = text = author = "";
        previewImage = null;
        stagedPhotos.Clear();
        galleryInputKey++;
        file = null;
        fileInputKey++; // czyści pole wyboru pliku
        added = true;
        await OnAdded.InvokeAsync();
    }

    private async Task Cancel()
    {
        await OnCancelled.InvokeAsync();
    }
}
