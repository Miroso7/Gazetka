@using System.Globalization
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using Microsoft.Extensions.Logging
@inject ILogger<ArticleForm> logger
@inject IArticleService articleService
@inject IFileService fileService
@inject IPermissionService permissionService

<div class="add-article-form">
    <h1 class="add-article-form__title">@(IsEditing ? "Edytuj artykuł" : "Dodaj artykuł")</h1>

    @if (added)
    {
        <div class="form-alert" role="status">Artykuł został dodany.</div>
    }

    @if (errorMessage != null)
    {
        <div class="auth-alert" role="alert">@errorMessage</div>
    }

    @if (previewImage != null)
    {
        <div class="image-preview">
            <img src="@previewImage" alt="zdjęcie" />
        </div>
    }

    <label class="form-label">@(IsEditing ? "Zdjęcie * (wybierz nowe, aby je zmienić)" : "Zdjęcie *")</label>
    <InputFile @key="fileInputKey" OnChange="ChoosePhoto" accept="image/*" class="form-control mb-3" />

    <form @onsubmit="SaveArticle" @onsubmit:preventDefault>
        <label class="form-label">Kategoria *</label>
        <select @bind="type" @bind:after="OnTypeChanged" class="form-select mb-3">
            @foreach (var option in ArticleTypeExtensions.Selectable(ArticleToEdit?.Type))
            {
                <option value="@option">@option.Label()</option>
            }
        </select>

        <label class="form-label">Tytuł *</label>
        <input @bind="title" class="form-control mb-3" placeholder="Wpisz tytuł..." />

        <label class="form-label">Treść *</label>
        <textarea @bind="text" class="form-control mb-1" rows="6" placeholder="Treść artykułu..."></textarea>
        <div class="form-text mb-3">
            Akapity oddzielaj pustą linią. Zdjęcia ułożysz niżej w sekcji „Galeria zdjęć”: dla każdego wybierzesz, czy ma być w tekście
            (po lewej, na środku lub po prawej) i po którym akapicie.
        </div>

        @if (typeFields.Count > 0)
        {
            <fieldset class="type-fields" @key="type">
                <legend class="type-fields__title">Szczegóły: @type.Label()</legend>
                <div class="type-fields__grid">
                    @foreach (var f in typeFields)
                    {
                        <div class="type-fields__item @(f.Kind == ArticleFieldKind.Checkbox ? "type-fields__item--wide" : "")" @key="f.Key">
                            @if (f.Kind == ArticleFieldKind.Checkbox)
                            {
                                <label class="type-check">
                                    <input type="checkbox"
                                           checked="@IsChecked(f.Key)"
                                           @onchange="e => SetChecked(f.Key, e.Value)" />
                                    <span>@f.Label</span>
                                </label>
                            }
                            else
                            {
                                <label class="form-label">@(f.Label + (f.Required ? " *" : ""))</label>
                                @if (f.Kind == ArticleFieldKind.Select)
                                {
                                    <select class="form-select mb-3" value="@GetDetail(f.Key)"
                                            @onchange="e => SetDetail(f.Key, e.Value?.ToString())">
                                        <option value="">Wybierz...</option>
                                        @foreach (var option in f.Options ?? Array.Empty<string>())
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="@f.InputType" class="form-control mb-3" placeholder="@f.Placeholder"
                                           min="@MinFor(f)"
                                           value="@GetDetail(f.Key)"
                                           @onchange="e => SetDetail(f.Key, e.Value?.ToString())" />
                                }
                            }
                        </div>
                    }
                </div>
            </fieldset>
        }

        <label class="form-label">Autor</label>
        <input @bind="author" class="form-control mb-4" placeholder="Imię i nazwisko" />

        <fieldset class="type-fields schedule-fields">
            <legend class="type-fields__title">Publikacja</legend>

            <label class="type-check">
                <input type="checkbox"
                       checked="@isPinned"
                       @onchange="e => isPinned = e.Value is true" />
                <span>Przypnij na górze listy (odznaka „Przypięte”)</span>
            </label>

            <div class="type-fields__grid">
                <div class="type-fields__item">
                    <label class="form-label" for="publish-date">Opublikuj od</label>
                    <div class="schedule-fields__pair">
                        <input id="publish-date" type="date" class="form-control" aria-label="Data publikacji" value="@publishDate" @onchange="e => publishDate = e.Value?.ToString() ?? string.Empty" />
                        <input type="time" class="form-control" aria-label="Godzina publikacji" value="@publishTime" @onchange="e => publishTime = e.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearPublish"
                                disabled="@(publishDate.Length == 0 && publishTime.Length == 0)">
                            Wyczyść
                        </button>
                    </div>
                    <div class="form-text mb-3">
                        Puste = od razu (przy edycji zostaje dotychczasowa data). Data w przyszłości zaplanuje publikację,
                        a do tego czasu artykuł widzi tylko redakcja.
                    </div>
                </div>

                <div class="type-fields__item">
                    <label class="form-label" for="expires-date">Wyświetlaj do</label>
                    <div class="schedule-fields__pair">
                        <input id="expires-date" type="date" class="form-control" aria-label="Data wygaśnięcia" value="@expiresDate" @onchange="e => expiresDate = e.Value?.ToString() ?? string.Empty" />
                        <input type="time" class="form-control" aria-label="Godzina wygaśnięcia" value="@expiresTime" @onchange="e => expiresTime = e.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearExpires"
                                disabled="@(expiresDate.Length == 0 && expiresTime.Length == 0)">
                            Wyczyść
                        </button>
                    </div>
                    <div class="form-text mb-3">
                        Puste = bez końca. Po tej dacie artykuł znika z listy i wyszukiwarki, ale link nadal działa.
                        Sama data oznacza koniec tego dnia.
                    </div>
                </div>
            </div>
        </fieldset>

        <label class="form-label">Galeria zdjęć (opcjonalnie)</label>
        @if (GalleryCount > 0)
        {
            var afterOptions = AfterOptions();
            <ul class="photo-list">
                @foreach (var photo in photos)
                {
                    var item = photo;
                    var number = NumberOf(item);
                    <li @key="item" class="photo-row">
                        <div class="photo-row__thumb">
                            <img src="@item.Url" alt="Zdjęcie @number z galerii" loading="lazy" decoding="async" />
                            <span class="gallery-edit__num" title="Numer zdjęcia w galerii">@number</span>
                            @if (item.IsNew)
                            {
                                <span class="gallery-edit__badge">Nowe</span>
                            }
                        </div>

                        <div class="photo-row__body">
                            <label class="photo-row__label" for="@($"photo-place-{number}")">Gdzie pokazać to zdjęcie</label>
                            <select id="@($"photo-place-{number}")" class="form-select" @bind="item.Placement">
                                <option value="@InlinePlacement.Gallery">Tylko w galerii pod artykułem</option>
                                <option value="@InlinePlacement.Left">W tekście – po lewej (tekst obtacza zdjęcie)</option>
                                <option value="@InlinePlacement.Center">W tekście – na środku, na całą szerokość</option>
                                <option value="@InlinePlacement.Right">W tekście – po prawej (tekst obtacza zdjęcie)</option>
                            </select>

                            @if (item.Placement != InlinePlacement.Gallery)
                            {
                                <label class="photo-row__label" for="@($"photo-after-{number}")">Miejsce w tekście</label>
                                <select id="@($"photo-after-{number}")" class="form-select" value="@ClampAfter(item)"
                                        @onchange="e => SetAfter(item, e.Value)">
                                    @foreach (var option in afterOptions)
                                    {
                                        <option value="@option.Index">@option.Label</option>
                                    }
                                </select>
                            }
                        </div>

                        <button type="button" class="photo-row__remove" @onclick="() => RemovePhoto(item)"
                                aria-label="Usuń zdjęcie z galerii" title="Usuń zdjęcie">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
                        </button>
                    </li>
                }
            </ul>
        }
        <InputFile @key="galleryInputKey" OnChange="ChooseGalleryPhotos" multiple accept="image/*"
                   disabled="@GalleryFull" class="form-control gallery-edit__input mb-1" />
        <div class="form-text gallery-edit__hint mb-4">
            Zdjęcia w galerii: @GalleryCount / @IArticleService.MaxGalleryImages (JPG, PNG, GIF lub WebP; zdjęcia do 25 MB są zmniejszane do 1920 px, GIF-y do 5 MB).
            Zmiany zapiszą się po kliknięciu „@(IsEditing ? "Zapisz zmiany" : "Dodaj")”.
        </div>

        <button type="button" class="btn btn-outline-primary w-100 mb-3" @onclick="OpenPreview"
                aria-haspopup="dialog">
            Podgląd artykułu
        </button>

        <button type="submit" class="btn btn-primary w-100">@(IsEditing ? "Zapisz zmiany" : "Dodaj")</button>
        @if (IsEditing)
        {
            <button type="button" class="btn btn-outline-primary w-100 mt-2" @onclick="Cancel">Anuluj</button>
        }
    </form>
</div>

@if (showPreview)
{
    @* podgląd na całym ekranie: otwiera się od razu na widoku, bez zjeżdżania na dół strony; Esc lub „Zamknij” wraca do formularza *@
    <div class="preview-overlay" role="dialog" aria-modal="true" aria-label="Podgląd artykułu"
         tabindex="-1" @ref="previewOverlay" @onkeydown="OnPreviewKeyDown">
        <header class="preview-overlay__bar">
            <span class="article-preview__label">Podgląd – tak artykuł zobaczą czytelnicy</span>
            <div class="preview-overlay__modes" role="group" aria-label="Rozmiar podglądu">
                <button type="button" class="preview-overlay__mode @(previewPhone ? null : "is-active")"
                        aria-pressed="@(previewPhone ? "false" : "true")" @onclick="() => previewPhone = false">
                    Komputer
                </button>
                <button type="button" class="preview-overlay__mode @(previewPhone ? "is-active" : null)"
                        aria-pressed="@(previewPhone ? "true" : "false")" @onclick="() => previewPhone = true">
                    Telefon
                </button>
            </div>
            <button type="button" class="btn btn-primary preview-overlay__close" @onclick="ClosePreview" title="Zamknij (Esc)">
                Zamknij podgląd
            </button>
        </header>
        <div class="preview-overlay__scroll">
            <div class="@("preview-overlay__frame" + (previewPhone ? " preview-overlay__frame--phone" : null))">
                <div class="article-preview">
                    <article class="ap">
                        <header class="ap-head">
                            <span class="ap-kicker">@type.Label()</span>
                            <h1 class="ap-title">@(string.IsNullOrWhiteSpace(title) ? "Tytuł artykułu" : title)</h1>
                            <div class="ap-meta">
                                <div class="ap-meta__text">
                                    <span class="ap-meta__author">@(string.IsNullOrWhiteSpace(author) ? "Autor" : author)</span>
                                    <span class="ap-meta__sub">@PreviewDate.ToString("dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                </div>
                            </div>
                        </header>

                        @if (previewImage != null)
                        {
                            <figure class="ap-figure">
                                <img src="@previewImage" alt="@title" class="ap-figure__img" />
                            </figure>
                        }

                        @if (PreviewDetails.Count > 0)
                        {
                            <dl class="ap-details">
                                @foreach (var (label, value) in PreviewDetails)
                                {
                                    <div class="ap-details__item">
                                        <dt>@label</dt>
                                        <dd>@value</dd>
                                    </div>
                                }
                            </dl>
                        }

                        <ArticleBody Text="@text" Photos="PreviewPhotos" Title="@title" />

                        @if (photos.Any(p => p.Placement == InlinePlacement.Gallery))
                        {
                            <p class="form-text">Pod artykułem pojawi się galeria zdjęć, które nie zostały ułożone w treści.</p>
                        }
                    </article>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string title = "";
    private string text = "";
    private string author = "";
    private ArticleType type = ArticleType.News;
    // publikacja: przypięcie oraz „Opublikuj od” i „Wyświetlaj do” (data i godzina w osobnych polach, puste = brak)
    private bool isPinned;
    private string publishDate = "";
    private string publishTime = "";
    private string expiresDate = "";
    private string expiresTime = "";
    // dodatkowe pola zależne od typu artykułu (klucz pola -> wartość)
    private Dictionary<string, string> details = new();
    private string? previewImage;
    private bool added;
    private string? errorMessage;
    private int fileInputKey;

    private int loadedArticleId;
    private int existingFileId;

    // galeria: zdjęcia już zapisane w artykule oraz nowe, czekające na zapis (trzymamy je w pamięci,
    // bo przeglądarka pozwala odczytać plik tylko zaraz po wybraniu)
    private readonly List<PhotoItem> photos = new();
    private readonly List<int> removedImageIds = new();
    private int galleryInputKey;

    // zdjęcie galerii: zapisane (Saved) albo nowe (Bytes); Placement i After to jego ułożenie w treści
    private class PhotoItem
    {
        public ArticleImageDto? Saved { get; init; }
        public byte[]? Bytes { get; init; }
        public required string Url { get; init; }
        public InlinePlacement Placement { get; set; }
        public int After { get; set; }
        public bool IsNew => Saved is null;
    }

    private bool showPreview;
    private bool previewPhone;
    private bool focusPreview;
    private ElementReference previewOverlay;

    // numer zdjęcia w galerii (od 1): najpierw zapisane, potem nowe – tak samo jak kolejność na stronie artykułu
    private int NumberOf(PhotoItem photo) => photos.IndexOf(photo) + 1;

    private int ParagraphCount => ArticleBodyMarkers.Split(text).Count(p => p.Text is not null);

    // miejsca w tekście, po których można ułożyć zdjęcie (0 = na początku)
    private List<(int Index, string Label)> AfterOptions()
    {
        var options = new List<(int Index, string Label)> { (0, "Na początku, przed pierwszym akapitem") };
        var paragraphs = ArticleBodyMarkers.Split(text).Where(p => p.Text is not null).Select(p => p.Text!).ToList();
        for (var i = 0; i < paragraphs.Count; i++)
        {
            var snippet = paragraphs[i].Length <= 40 ? paragraphs[i] : paragraphs[i][..40].TrimEnd() + "…";
            options.Add((i + 1, $"Po akapicie {i + 1}: „{snippet}”"));
        }
        return options;
    }

    // po skróceniu tekstu zdjęcie wskazujące nieistniejący akapit pokazuje się na końcu
    private int ClampAfter(PhotoItem photo) => Math.Min(photo.After, ParagraphCount);

    private static void SetAfter(PhotoItem photo, object? value) =>
        photo.After = int.TryParse(value?.ToString(), out var index) ? Math.Max(0, index) : 0;

    private DateTime PreviewDate
    {
        get
        {
            try
            {
                return ParseMoment(publishDate, publishTime, TimeSpan.Zero, "Opublikuj od") ?? ArticleToEdit?.PublishDate ?? DateTime.Now;
            }
            catch (InvalidOperationException)
            {
                // data jeszcze niepoprawna – w podglądzie pokazujemy dotychczasową, błąd pokaże się przy zapisie
                return ArticleToEdit?.PublishDate ?? DateTime.Now;
            }
        }
    }

    private void ClearPublish() => publishDate = publishTime = "";

    private void ClearExpires() => expiresDate = expiresTime = "";

    private static string DateText(DateTime? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";

    private static string TimeText(DateTime? value) => value?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "";

    // data z pola daty i godzina z pola godziny; sama data = podana godzina domyślna (początek albo koniec dnia), puste pola = null
    private static DateTime? ParseMoment(string date, string time, TimeSpan defaultTime, string label)
    {
        if (string.IsNullOrWhiteSpace(date))
        {
            if (!string.IsNullOrWhiteSpace(time))
            {
                throw new InvalidOperationException($"Wybierz też datę w polu „{label}”.");
            }
            return null;
        }

        if (!DateTime.TryParseExact(date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var day))
        {
            throw new InvalidOperationException($"Niepoprawna data w polu „{label}”.");
        }

        var clock = defaultTime;
        if (!string.IsNullOrWhiteSpace(time)
            && !TimeSpan.TryParseExact(time, new[] { "hh\\:mm", "hh\\:mm\\:ss" }, CultureInfo.InvariantCulture, out clock))
        {
            throw new InvalidOperationException($"Niepoprawna godzina w polu „{label}”.");
        }

        return day.Date + clock;
    }

    // pola formularza pokazują tylko minuty, więc niezmieniona data zostaje co do sekundy taka, jak w bazie
    private static bool SameMinute(DateTime a, DateTime b) =>
        a.Date == b.Date && a.Hour == b.Hour && a.Minute == b.Minute;

    private IReadOnlyList<ArticleBodyPhoto> PreviewPhotos =>
        photos.Select(p => new ArticleBodyPhoto(p.Url, p.Placement, p.After)).ToList();

    private List<(string Label, string Value)> PreviewDetails
    {
        get
        {
            try
            {
                return ArticleFields.Display(new Article
                {
                    Title = title,
                    Text = text,
                    Author = author,
                    Type = type,
                    Details = ArticleFields.ToJson(type, details)
                });
            }
            catch (InvalidOperationException)
            {
                // pola szczegółów jeszcze niepoprawne – w podglądzie je pomijamy, błąd pokaże się przy zapisie
                return new();
            }
        }
    }

    private int GalleryCount => photos.Count;
    private bool GalleryFull => GalleryCount >= IArticleService.MaxGalleryImages;

    // gdy ustawiony, formularz działa w trybie edycji tego artykułu
    [Parameter]
    public Article? ArticleToEdit { get; set; }
    [Parameter]
    public EventCallback OnAdded { get; set; }
    [Parameter]
    public EventCallback OnEdited { get; set; }
    [Parameter]
    public EventCallback OnCancelled { get; set; }

    IBrowserFile? file;

    private bool IsEditing => ArticleToEdit != null;

    private IReadOnlyList<ArticleField> typeFields => ArticleFields.For(type);

    private string GetDetail(string key) => details.TryGetValue(key, out var value) ? value : "";

    private void SetDetail(string key, string? value) => details[key] = value ?? "";

    // pole liczbowe nie przyjmuje wartości ujemnych
    private static string? MinFor(ArticleField f) => f.Kind == ArticleFieldKind.Number ? "0" : null;

    private bool IsChecked(string key) => GetDetail(key) == "true";

    private void SetChecked(string key, object? value) => details[key] = value is true ? "true" : "";

    // inny typ ma inne pola, więc wpisane wartości czyścimy
    private void OnTypeChanged()
    {
        details.Clear();
        errorMessage = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ArticleToEdit is null || loadedArticleId == ArticleToEdit.Id) return;

        loadedArticleId = ArticleToEdit.Id;
        title = ArticleToEdit.Title ?? "";
        text = ArticleToEdit.Text ?? "";
        author = ArticleToEdit.Author ?? "";
        type = ArticleToEdit.Type;
        isPinned = ArticleToEdit.IsPinned;
        publishDate = DateText(ArticleToEdit.PublishDate);
        publishTime = TimeText(ArticleToEdit.PublishDate);
        expiresDate = DateText(ArticleToEdit.ExpiresAt);
        expiresTime = TimeText(ArticleToEdit.ExpiresAt);
        details = ArticleFields.Parse(ArticleToEdit.Details);
        existingFileId = ArticleToEdit.FileId;
        previewImage = null;

        try
        {
            var fileName = await fileService.GetFileNameByIdAsync(existingFileId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                previewImage = $"/Images/{fileName}";
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Nie udało się wczytać zdjęcia okładki artykułu {ArticleId}.", loadedArticleId);
        }

        photos.Clear();
        removedImageIds.Clear();
        try
        {
            photos.AddRange((await articleService.GetArticleImagesAsync(ArticleToEdit.Id)).Select(image => new PhotoItem
            {
                Saved = image,
                Url = image.Url,
                Placement = image.Placement,
                After = image.InlineAfter
            }));

            // stare znaczniki [foto:N] w treści zamieniamy na ułożenie zdjęć (tekst zostaje czysty)
            if (ArticleBodyMarkers.StripMarkers(text) != text)
            {
                text = ArticleBodyMarkers.ExtractLegacyMarkers(text, photos.Count, out var legacy);
                foreach (var (index, placement) in legacy)
                {
                    if (photos[index].Placement != InlinePlacement.Gallery) continue;
                    photos[index].Placement = placement.Placement;
                    photos[index].After = placement.After;
                }
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Nie udało się wczytać galerii artykułu {ArticleId}.", loadedArticleId);
        }
    }

    private async Task ChooseGalleryPhotos(InputFileChangeEventArgs e)
    {
        added = false;
        errorMessage = null;

        IReadOnlyList<IBrowserFile> picked;
        try
        {
            picked = e.GetMultipleFiles(IArticleService.MaxGalleryImages);
        }
        catch (InvalidOperationException)
        {
            errorMessage = $"Naraz można wybrać maksymalnie {IArticleService.MaxGalleryImages} zdjęć.";
            galleryInputKey++;
            return;
        }

        var skipped = 0;
        foreach (var picture in picked)
        {
            if (GalleryFull)
            {
                skipped++;
                continue;
            }

            try
            {
                // zdjęcie jest zmniejszane do 1920 px jeszcze w przeglądarce (GIF zostaje bez zmian)
                var bytes = await fileService.ReadImageAsync(picture);

                // zawartość musi być zdjęciem (serwer sprawdza to jeszcze raz przy zapisie)
                if (!fileService.IsSupportedImage(bytes)) { skipped++; continue; }

                // mała miniatura robiona w przeglądarce, żeby nie wysyłać pełnych zdjęć do podglądu
                var thumbnail = await picture.RequestImageFileAsync("image/jpeg", 480, 480);
                using var thumbStream = thumbnail.OpenReadStream(1024 * 1024);
                using var thumbMemory = new MemoryStream();
                await thumbStream.CopyToAsync(thumbMemory);

                photos.Add(new PhotoItem
                {
                    Bytes = bytes,
                    Url = $"data:image/jpeg;base64,{Convert.ToBase64String(thumbMemory.ToArray())}"
                });
            }
            catch (Exception ex)
            {
                logger.LogWarning(ex, "Pominięto zdjęcie do galerii {FileName}: nie udało się go wczytać.", picture.Name);
                skipped++;
            }
        }

        if (skipped > 0)
        {
            errorMessage = $"Pominięto zdjęcia: {skipped} (dozwolone JPG, PNG, GIF lub WebP; zdjęcia do 25 MB, GIF-y do 5 MB; limit galerii: {IArticleService.MaxGalleryImages}).";
        }
        galleryInputKey++; // czyści pole wyboru, żeby można było dodać kolejne zdjęcia
    }

    private void RemovePhoto(PhotoItem photo)
    {
        photos.Remove(photo);
        if (photo.Saved is { } saved)
        {
            removedImageIds.Add(saved.Id);
        }
    }

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        added = false;
        errorMessage = null;
        file = e.File;
        try
        {
            previewImage = await fileService.GetPreviewAsync(file);
        }
        catch (InvalidOperationException ex)
        {
            // za duży plik albo nie zdjęcie: nie zostawiamy go do zapisu
            file = null;
            previewImage = null;
            errorMessage = ex.Message;
            fileInputKey++;
        }
    }

    private async Task SaveArticle()
    {
        try
        {
            await SaveArticleCore();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SaveArticleCore()
    {
        // sprawdzamy permisję zanim cokolwiek wgramy (zdjęcie trafia na dysk jeszcze przed zapisem artykułu)
        var needed = IsEditing ? EnumPermissions.EditArticle : EnumPermissions.AddArticle;
        if (!await permissionService.HasPermissionAsync(needed))
        {
            errorMessage = IsEditing
                ? "Nie masz uprawnienia do edycji artykułów."
                : "Nie masz uprawnienia do dodawania artykułów.";
            return;
        }

        // tytuł i treść są wymagane (autor jest opcjonalny); sprawdzamy to przed wgraniem zdjęcia
        added = false;
        if (string.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Podaj tytuł artykułu.";
            return;
        }
        if (string.IsNullOrWhiteSpace(text))
        {
            errorMessage = "Podaj treść artykułu.";
            return;
        }

        // pola zależne od typu sprawdzamy teraz, żeby nie wgrywać zdjęć, gdy formularz jest niepoprawny
        ArticleFields.ToJson(type, details);

        // daty publikacji też sprawdzamy przed wgraniem zdjęć; brak „Opublikuj od” = od razu (przy edycji zostaje dotychczasowa data)
        var publishAt = ParseMoment(publishDate, publishTime, TimeSpan.Zero, "Opublikuj od");
        var expiresAt = ParseMoment(expiresDate, expiresTime, new TimeSpan(23, 59, 59), "Wyświetlaj do");
        if (IsEditing && ArticleToEdit is { } original)
        {
            if (publishAt is { } p && SameMinute(p, original.PublishDate)) publishAt = original.PublishDate;
            if (expiresAt is { } x && original.ExpiresAt is { } was && SameMinute(x, was)) expiresAt = was;
        }
        // przy edycji bez „Opublikuj od” porównanie z dotychczasową datą robi serwer
        var effectiveStart = publishAt ?? (IsEditing ? null : DateTime.Now);
        if (effectiveStart is { } start && expiresAt is { } end && end <= start)
        {
            errorMessage = "Data „Wyświetlaj do” musi być późniejsza niż „Opublikuj od”.";
            return;
        }

        // zdjęcie jest wymagane: przy dodawaniu trzeba wybrać plik,
        // przy edycji wystarczy dotychczasowe zdjęcie albo nowe
        var hasPhoto = file != null || (IsEditing && existingFileId > 0);
        if (!hasPhoto)
        {
            errorMessage = "Dodaj zdjęcie do artykułu.";
            return;
        }
        errorMessage = null;

        // zdjęcia do galerii wgrywamy dopiero przy zapisie (wszystkie albo żadne)
        var newPhotos = photos.Where(p => p.IsNew).ToList();
        var galleryFileIds = newPhotos.Count > 0
            ? await fileService.UploadImages(newPhotos.Select(p => p.Bytes!).ToList())
            : new List<int>();
        var newPlacements = newPhotos.Select(p => new ArticleImagePlacement(p.Placement, p.After)).ToList();

        if (IsEditing)
        {
            // bez nowego zdjęcia zostaje dotychczasowe
            int fileId = existingFileId;
            if (file != null)
            {
                fileId = await fileService.UploadImage(file);
            }
            var changedPlacements = photos
                .Where(p => p.Saved is not null)
                .ToDictionary(p => p.Saved!.Id, p => new ArticleImagePlacement(p.Placement, p.After));
            await articleService.UpdateArticleAsync(ArticleToEdit!.Id, title, text, author, type, fileId, galleryFileIds, removedImageIds, details,
                isPinned, publishAt, expiresAt, newPlacements, changedPlacements);
            file = null;
            await OnEdited.InvokeAsync();
            return;
        }

        int id = 0;
        if (file != null)
        {
            id = await fileService.UploadImage(file);
        }
        await articleService.AddArticleAsync(title, text, author, type, id, galleryFileIds, details, isPinned, publishAt, expiresAt, newPlacements);
        title = text = author = "";
        isPinned = false;
        publishDate = publishTime = expiresDate = expiresTime = "";
        details = new();
        previewImage = null;
        showPreview = false;
        photos.Clear();
        galleryInputKey++;
        file = null;
        fileInputKey++; // czyści pole wyboru pliku
        added = true;
        await OnAdded.InvokeAsync();
    }

    private void OpenPreview()
    {
        showPreview = true;
        focusPreview = true;
    }

    private void ClosePreview() => showPreview = false;

    private void OnPreviewKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ClosePreview();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // fokus na podglądzie, żeby Esc działał od razu po otwarciu
        if (!focusPreview || !showPreview) return;
        focusPreview = false;

        try { await previewOverlay.FocusAsync(); }
        catch (Exception) { }
    }

    private async Task Cancel()
    {
        await OnCancelled.InvokeAsync();
    }
}
