@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService
@inject IFileService fileService
@inject IPermissionService permissionService

<div class="add-article-form">
    <h1 class="add-article-form__title">@(IsEditing ? "Edytuj artykuł" : "Dodaj artykuł")</h1>

    @if (added)
    {
        <div class="form-alert" role="status">Artykuł został dodany.</div>
    }

    @if (errorMessage != null)
    {
        <div class="auth-alert" role="alert">@errorMessage</div>
    }

    @if (previewImage != null)
    {
        <div class="image-preview">
            <img src="@previewImage" alt="zdjęcie" />
        </div>
    }

    <label class="form-label">@(IsEditing ? "Zdjęcie * (wybierz nowe, aby je zmienić)" : "Zdjęcie *")</label>
    <InputFile @key="fileInputKey" OnChange="ChoosePhoto" accept="image/*" class="form-control mb-3" />

    <form @onsubmit="SaveArticle" @onsubmit:preventDefault>
        <label class="form-label">Tytuł</label>
        <input @bind="title" class="form-control mb-3" placeholder="Wpisz tytuł..." />

        <label class="form-label">Treść</label>
        <textarea @bind="text" class="form-control mb-3" rows="6" placeholder="Treść artykułu..."></textarea>

        <label class="form-label">Autor</label>
        <input @bind="author" class="form-control mb-4" placeholder="Imię i nazwisko" />

        <button type="submit" class="btn btn-primary w-100">@(IsEditing ? "Zapisz zmiany" : "Dodaj")</button>
        @if (IsEditing)
        {
            <button type="button" class="btn btn-outline-primary w-100 mt-2" @onclick="Cancel">Anuluj</button>
        }
    </form>
</div>

@code {
    private string title = "";
    private string text = "";
    private string author = "";
    private string? previewImage;
    private bool added;
    private string? errorMessage;
    private int fileInputKey;

    private int loadedArticleId;
    private int existingFileId;

    // gdy ustawiony, formularz działa w trybie edycji tego artykułu
    [Parameter]
    public Article? ArticleToEdit { get; set; }
    [Parameter]
    public EventCallback OnAdded { get; set; }
    [Parameter]
    public EventCallback OnEdited { get; set; }
    [Parameter]
    public EventCallback OnCancelled { get; set; }

    IBrowserFile? file;

    private bool IsEditing => ArticleToEdit != null;

    protected override async Task OnParametersSetAsync()
    {
        if (ArticleToEdit is null || loadedArticleId == ArticleToEdit.Id) return;

        loadedArticleId = ArticleToEdit.Id;
        title = ArticleToEdit.Title ?? "";
        text = ArticleToEdit.Text ?? "";
        author = ArticleToEdit.Author ?? "";
        existingFileId = ArticleToEdit.FileId;
        previewImage = null;

        try
        {
            var fileName = await fileService.GetFileNameByIdAsync(existingFileId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                previewImage = $"/Images/{fileName}";
            }
        }
        catch (Exception) { }
    }

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);
        added = false;
        errorMessage = null;
    }

    private async Task SaveArticle()
    {
        try
        {
            await SaveArticleCore();
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SaveArticleCore()
    {
        // sprawdzamy permisję zanim cokolwiek wgramy (zdjęcie trafia na dysk jeszcze przed zapisem artykułu)
        var needed = IsEditing ? EnumPermissions.EditArticle : EnumPermissions.AddArticle;
        if (!await permissionService.HasPermissionAsync(needed))
        {
            errorMessage = IsEditing
                ? "Nie masz uprawnienia do edycji artykułów."
                : "Nie masz uprawnienia do dodawania artykułów.";
            return;
        }

        // zdjęcie jest wymagane: przy dodawaniu trzeba wybrać plik,
        // przy edycji wystarczy dotychczasowe zdjęcie albo nowe
        var hasPhoto = file != null || (IsEditing && existingFileId > 0);
        if (!hasPhoto)
        {
            errorMessage = "Dodaj zdjęcie do artykułu.";
            return;
        }
        errorMessage = null;

        if (IsEditing) 
        {
            // bez nowego zdjęcia zostaje dotychczasowe
            int fileId = existingFileId;
            if (file != null)
            {
                fileId = await fileService.UploadImage(file);
            }
            await articleService.UpdateArticleAsync(ArticleToEdit!.Id, title, text, author, fileId);
            file = null;
            await OnEdited.InvokeAsync();
            return;
        }

        int id = 0;
        if (file != null)
        {
            id = await fileService.UploadImage(file);
        }
        await articleService.AddArticleAsync(title, text, author, id);
        title = text = author = "";
        previewImage = null;
        file = null;
        fileInputKey++; // czyści pole wyboru pliku
        added = true;
        await OnAdded.InvokeAsync();
    }

    private async Task Cancel()
    {
        await OnCancelled.InvokeAsync();
    }
}
