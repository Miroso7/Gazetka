@using System.Globalization
@using Microsoft.Extensions.Logging
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service

<div class="article-grid">
    @if (Articles.Count == 0)
    {
        <div class="empty-state">@EmptyText</div>
    }

    @for (var i = 0; i < Articles.Count; i++)
    {
        var article = Articles[i];
        var imageUrl = GetImageUrl(article.FileId);
        var featured = !permissions && FirstPage && Articles.Count > 2 && i == 0;
        var isNewest = !permissions && FirstPage && Articles.Count > 1 && article.Id == newestId;

        <article @key="article.Id"
                 class="article-card article-card--@article.Type.CssName() @(featured ? "article-card--featured" : "") @(permissions ? "article-card--admin" : "") @(article.IsPinned ? "article-card--pinned" : "")"
                 style="--i:@Math.Min(i, 8)">

            <div class="article-card__img-wrap">
                @if (!string.IsNullOrEmpty(imageUrl))
                {
                    <img src="@imageUrl"
                         class="article-card__img"
                         alt="@article.Title"
                         loading="@(i == 0 ? "eager" : "lazy")"
                         decoding="async" />
                }
                else
                {
                    <div class="article-card__placeholder" aria-hidden="true">
                        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2" /><path d="M18 14h-8M15 18h-5M10 6h8v4h-8V6Z" /></svg>
                    </div>
                }

                @if (isNewest)
                {
                    <span class="article-card__badge">Nowe</span>
                }

                @if (article.IsPinned)
                {
                    <span class="article-card__pin">
                        <svg class="article-card__pin-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5M9 3h6l-1 6 3 3v2H7v-2l3-3-1-6Z" /></svg>
                        Przypięte
                    </span>
                }
            </div>

            <div class="article-card__body">
                <div class="article-card__top">
                    @if (ShowType)
                    {
                        <span class="article-card__type article-card__type--@article.Type.CssName()">@article.Type.Label()</span>
                    }
                    <span class="article-card__read">
                        <svg class="article-card__read-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                        @ReadMinutes(ArticleBodyMarkers.StripMarkers(article.Text)) min czytania
                    </span>
                </div>

                <h3 class="article-card__title">
                    @if (permissions)
                    {
                        @article.Title
                    }
                    else
                    {
                        <NavLink class="article-card__link" href="@($"/article/{article.Id}")">@article.Title</NavLink>
                    }
                </h3>

                <p class="article-card__text">@Excerpt(ArticleBodyMarkers.StripMarkers(article.Text))</p>

                @if (permissions)
                {
                    @Byline(article)
                }

                <div class="article-card__footer">
                    @if (permissions)
                    {
                        <div class="article-card__actions">
                            @if (confirmId == article.Id)
                            {
                                <span class="article-card__ask">Usunąć ten artykuł?</span>
                                <button class="btn btn-sm btn-danger-solid" @onclick="() => RemoveArticleByIdAsync(article.Id)">Tak, usuń</button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => confirmId = null">Anuluj</button>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/article/@article.Id">Podgląd</a>
                                @if (OnEdit.HasDelegate)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OnEdit.InvokeAsync(article)">
                                        Edytuj
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmId = article.Id">
                                    Usuń artykuł
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        @Byline(article)
                        <span class="article-card__more" aria-hidden="true">
                            <span class="article-card__more-label">Czytaj</span>
                            <span class="article-card__arrow">→</span>
                        </span>
                    }
                </div>
            </div>
        </article>
    }
</div>

@code {
    [Parameter]
    public List<Article> Articles { get; set; } = new();
    [Parameter]
    public bool permissions { get; set; }
    // kolejne strony listy nie mają wyróżnionego artykułu ani odznaki „Nowe”
    [Parameter]
    public bool FirstPage { get; set; } = true;
    // etykieta typu artykułu nad tytułem (na stronach pojedynczych zakładek jest zbędna)
    [Parameter]
    public bool ShowType { get; set; } = true;
    [Parameter]
    public string EmptyText { get; set; } = "Nie ma jeszcze żadnych artykułów.";

    // opcjonalne: gdy rodzic poda OnEdit, w trybie permissions pojawia się przycisk „Edytuj"

    [Parameter]
    public EventCallback<Article> OnEdit { get; set; }
    [Inject]
    public required IArticleService articleService { get; set; }
    [Inject]
    public required IFileService fileService { get; set; }
    [Inject]
    public required IAuthService authService { get; set; }
    [Inject]
    public required ILogger<ArticleCard> logger { get; set; }

    // fileId -> adres obrazka (null = artykuł bez zdjęcia); cache zapobiega powtórnym zapytaniom

    private readonly Dictionary<int, string?> imageUrls = new();
    // podpis autora -> adres zdjęcia profilowego (autorzy bez zdjęcia mają w podpisie inicjały)
    private Dictionary<string, string> authorAvatars = new();
    private string? authorsKey;
    private int? confirmId;

    // autor i data publikacji (w trybie publicznym w stopce karty, w panelu nad przyciskami); czas czytania jest osobno, nad tytułem
    private RenderFragment Byline(Article article) => @<div class="article-card__meta">
        <AuthorAvatar Name="@article.Author" Url="@AvatarOf(article.Author)" Class="article-card__avatar" />
        <span class="article-card__byline">
            <span class="article-card__author">@(string.IsNullOrWhiteSpace(article.Author) ? "Redakcja" : article.Author)</span>
            <span class="article-card__time">
                <time datetime="@(article.PublishDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))">@(article.PublishDate.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture))</time>
            </span>
        </span>
    </div>;

    // najnowsze ID liczone raz na zmianę parametrów, a nie osobno dla każdej karty
    private int newestId = -1;

    protected override async Task OnParametersSetAsync()
    {
        newestId = Articles.Count == 0 ? -1 : Articles.Max(a => a.Id);

        foreach (var fileId in Articles.Select(a => a.FileId).Distinct())
        {
            if (imageUrls.ContainsKey(fileId)) continue;

            var fileName = await fileService.GetFileNameByIdAsync(fileId);
            imageUrls[fileId] = string.IsNullOrWhiteSpace(fileName) ? null : $"/Images/{fileName}";
        }

        await LoadAuthorAvatarsAsync();
    }

    // zdjęcia profilowe wczytujemy tylko, gdy zmieni się zestaw autorów na liście
    private async Task LoadAuthorAvatarsAsync()
    {
        var authors = Articles.Select(a => a.Author).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var key = string.Join('\n', authors);
        if (key == authorsKey) return;

        try
        {
            authorAvatars = await authService.GetAuthorAvatarUrlsAsync(authors);
            authorsKey = key;
        }
        catch (Exception ex)
        {
            // bez zdjęć profilowych karty nadal działają (w podpisach są inicjały)
            logger.LogWarning(ex, "Nie udało się wczytać zdjęć profilowych autorów.");
            authorAvatars = new();
        }
    }

    private string? AvatarOf(string? author) =>
        author is not null && authorAvatars.TryGetValue(author, out var url) ? url : null;

    private string GetImageUrl(int fileId)
    {
        return imageUrls.TryGetValue(fileId, out var url) ? url ?? "" : "";
    }

    public async Task RemoveArticleByIdAsync(int id)
    {
        await articleService.RemoveArticleByIdAsync(id);
        Article? article = Articles.FirstOrDefault(a => a.Id == id);
        if (article != null)
        {
            Articles.Remove(article);
        }
        confirmId = null;
    }

    private static string Excerpt(string? text, int max = 180)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";

        var t = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        if (t.Length <= max) return t;

        var cut = t.LastIndexOf(' ', max);
        if (cut < max / 2) cut = max;
        return t[..cut].TrimEnd(',', '.', ';', ':', '-', ' ') + "…";
    }

    private static int ReadMinutes(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return 1;

        int words = 0;
        bool inWord = false;
        foreach (var c in text)
        {
            if (char.IsWhiteSpace(c)) inWord = false;
            else if (!inWord) { inWord = true; words++; }
        }
        return Math.Max(1, (int)Math.Ceiling(words / 200.0));
    }
}
