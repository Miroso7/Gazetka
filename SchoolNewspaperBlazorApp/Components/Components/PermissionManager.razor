@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using Microsoft.Extensions.Logging
@inject IPermissionService PermissionService
@inject IAuthService AuthService
@inject ILogger<PermissionManager> Logger

<div class="perm-legend panel">
    <div class="panel__head">
        <h2 class="panel__title">Dostępne uprawnienia</h2>
    </div>
    <ul class="perm-legend__list">
        @foreach (var p in PermissionInfo.All)
        {
            <li>
                <span class="perm-legend__name">@PermissionInfo.Label(p)</span>
                <span class="perm-legend__desc">@PermissionInfo.Description(p)</span>
            </li>
        }
    </ul>
</div>

<div class="panel perm-panel">
    <div class="a-toolbar">
        <div class="field">
            <input class="field__input perm-search" type="search" placeholder="Szukaj użytkownika (imię, nazwisko lub e-mail)..."
                   aria-label="Szukaj użytkownika"
                   @bind="search" @bind:event="oninput" />
        </div>
    </div>

    @if (error != null)
    {
        <div class="auth-alert perm-alert" role="alert">@error</div>
    }
    else if (info != null)
    {
        <div class="form-alert perm-alert" role="status">@info</div>
    }

    @if (loading)
    {
        <div class="skel-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
    }
    else
    {
        var items = Filtered.ToList();
        if (items.Count == 0)
        {
            <div class="empty-state">
                @(users.Count == 0 ? "Nie ma jeszcze żadnych użytkowników." : "Brak użytkowników pasujących do wyszukiwania.")
            </div>
        }
        else
        {
            <ul class="perm-list">
                @foreach (var u in items)
                {
                    <li class="perm-row" @key="u.UserId">
                        <div class="perm-row__user perm-row__user--avatar">
                            @* zdjęcie profilowe użytkownika, a gdy go nie ma – inicjały *@
                            <AuthorAvatar Name="@u.DisplayName" Url="@u.AvatarUrl" Class="perm-row__avatar" />
                            <div class="perm-row__ident">
                                @if (u.FullName.Length > 0)
                                {
                                    <span class="perm-row__name">@u.FullName</span>
                                    <span class="perm-row__email">@u.Email · @u.Role.Label()</span>
                                }
                                else
                                {
                                    <span class="perm-row__name">@u.Email</span>
                                    <span class="perm-row__email">@u.Role.Label()</span>
                                }
                            </div>
                        </div>
                        <div class="perm-row__chips">
                            @foreach (var p in PermissionInfo.All)
                            {
                                var has = u.Permissions.Contains(p);
                                var key = (u.UserId, p);
                                <label class="perm-chip @(has ? "is-on" : "")" title="@PermissionInfo.Description(p)">
                                    <input type="checkbox"
                                           checked="@has"
                                           disabled="@busy.Contains(key)"
                                           @onchange="e => ToggleAsync(u, p, (bool)(e.Value ?? false))" />
                                    <span>@PermissionInfo.Label(p)</span>
                                </label>
                            }
                        </div>
                        <div class="perm-row__actions">
                            <button type="button" class="link-btn" @onclick="() => GrantAllAsync(u)">Nadaj wszystkie</button>
                            <button type="button" class="link-btn" @onclick="() => OpenEdit(u)">Edytuj dane</button>
                            @if (viewerIsMaster && u.AvatarFileName is not null)
                            {
                                <button type="button" class="link-btn link-btn--danger" @onclick="() => pendingAvatarRemoval = u">Usuń zdjęcie</button>
                            }
                            @if (u.IsMaster)
                            {
                                <span class="perm-row__badge">Master</span>
                            }
                            else if (!u.IsCurrentUser)
                            {
                                <button type="button" class="link-btn link-btn--danger" @onclick="() => pendingDelete = u">Usuń użytkownika</button>
                            }
                        </div>
                    </li>
                }
            </ul>
            <div class="a-foot">Wyświetlono @items.Count z @users.Count</div>
        }
    }
</div>

@if (editing != null)
{
    <div class="confirm">
        <div class="confirm__scrim" @onclick="CancelEdit"></div>
        <div class="confirm__dialog user-edit" role="dialog" aria-modal="true" aria-labelledby="user-edit-title">
            <h2 id="user-edit-title" class="confirm__title">Edytuj użytkownika</h2>

            @if (editError != null)
            {
                <div class="auth-alert" role="alert">@editError</div>
            }

            <form @onsubmit="SaveEditAsync" @onsubmit:preventDefault>
                <label class="form-label">Imię</label>
                <input @bind="editFirstName" class="form-control mb-3" placeholder="Imię" />

                <label class="form-label">Nazwisko</label>
                <input @bind="editLastName" class="form-control mb-3" placeholder="Nazwisko" />

                <label class="form-label">E-mail</label>
                <input @bind="editEmail" type="email" class="form-control mb-1" placeholder="E-mail" disabled="@editing.IsCurrentUser" />
                @if (editing.IsCurrentUser)
                {
                    <div class="form-text mb-3">E-maila własnego konta nie można zmienić.</div>
                }
                else
                {
                    <div class="mb-2"></div>
                }

                <label class="form-label">Rola</label>
                <select @bind="editRole" class="form-select mb-2">
                    @foreach (var option in Enum.GetValues<UserRole>())
                    {
                        <option value="@option">@option.Label()</option>
                    }
                </select>
                <div class="form-text mb-3">Hasła nie można zmienić z panelu.</div>

                <div class="confirm__actions">
                    <button type="button" class="btn btn-outline-primary" @onclick="CancelEdit" disabled="@saving">Anuluj</button>
                    <button type="submit" class="btn btn-primary" disabled="@saving">@(saving ? "Zapisywanie..." : "Zapisz")</button>
                </div>
            </form>
        </div>
    </div>
}

@if (pendingAvatarRemoval != null)
{
    <div class="confirm">
        <div class="confirm__scrim" @onclick="CancelAvatarRemoval"></div>
        <div class="confirm__dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-avatar-title">
            <div class="confirm__icon">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" /></svg>
            </div>
            <h2 id="confirm-avatar-title" class="confirm__title">Usunąć zdjęcie profilowe?</h2>
            <p class="confirm__text">Zdjęcie użytkownika „@pendingAvatarRemoval.DisplayName” zostanie usunięte, a zamiast niego pojawią się inicjały. Użytkownik może potem dodać nowe zdjęcie w zakładce „Moje konto”.</p>
            <div class="confirm__actions">
                <button type="button" class="btn btn-outline-primary" @onclick="CancelAvatarRemoval" disabled="@removingAvatar">Anuluj</button>
                <button type="button" class="btn btn-danger-solid" @onclick="ConfirmAvatarRemovalAsync" disabled="@removingAvatar">
                    @(removingAvatar ? "Usuwanie..." : "Usuń zdjęcie")
                </button>
            </div>
        </div>
    </div>
}

@if (pendingDelete != null)
{
    <div class="confirm">
        <div class="confirm__scrim" @onclick="CancelDelete"></div>
        <div class="confirm__dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-user-title">
            <div class="confirm__icon">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" /></svg>
            </div>
            <h2 id="confirm-user-title" class="confirm__title">Usunąć użytkownika?</h2>
            <p class="confirm__text">Konto „@pendingDelete.DisplayName” zostanie usunięte, a użytkownik nie będzie mógł się zalogować. Z panelu nie można tego cofnąć.</p>
            <div class="confirm__actions">
                <button type="button" class="btn btn-outline-primary" @onclick="CancelDelete" disabled="@deleting">Anuluj</button>
                <button type="button" class="btn btn-danger-solid" @onclick="ConfirmDeleteAsync" disabled="@deleting">
                    @(deleting ? "Usuwanie..." : "Usuń")
                </button>
            </div>
        </div>
    </div>
}

@code {
    // wywoływane po każdej zmianie, żeby panel mógł odświeżyć uprawnienia zalogowanej osoby
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private List<UserWithPermissions> users = new();
    private readonly HashSet<(int UserId, EnumPermissions Permission)> busy = new();
    private bool loading = true;
    private string search = "";
    private string? error;
    private string? info;
    private UserWithPermissions? pendingDelete;
    private bool deleting;

    // usuwanie cudzego zdjęcia profilowego: tylko master (serwer sprawdza to jeszcze raz)
    private bool viewerIsMaster;
    private UserWithPermissions? pendingAvatarRemoval;
    private bool removingAvatar;

    // edycja danych użytkownika (imię, nazwisko, e-mail, rola) – hasła nie da się zmienić
    private UserWithPermissions? editing;
    private string editFirstName = "";
    private string editLastName = "";
    private string editEmail = "";
    private UserRole editRole = UserRole.Student;
    private string? editError;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private IEnumerable<UserWithPermissions> Filtered =>
        string.IsNullOrWhiteSpace(search)
            ? users
            : users.Where(u => u.FullName.Contains(search, StringComparison.CurrentCultureIgnoreCase)
                            || u.Email.Contains(search, StringComparison.CurrentCultureIgnoreCase));

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            viewerIsMaster = await PermissionService.HasPermissionAsync(EnumPermissions.Master);
            users = await PermissionService.GetUsersWithPermissionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            users = new();
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleAsync(UserWithPermissions user, EnumPermissions permission, bool granted)
    {
        var key = (user.UserId, permission);
        busy.Add(key);
        error = info = null;
        try
        {
            await PermissionService.SetPermissionAsync(user.UserId, permission, granted);
            if (granted) user.Permissions.Add(permission); else user.Permissions.Remove(permission);
            info = granted
                ? $"Nadano „{PermissionInfo.Label(permission)}” użytkownikowi {user.DisplayName}."
                : $"Odebrano „{PermissionInfo.Label(permission)}” użytkownikowi {user.DisplayName}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            error = ex.Message;
            await LoadAsync(); // przywraca prawdziwy stan pól wyboru
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się zmienić uprawnienia {Permission} użytkownika {UserId}.", permission, user.UserId);
            error = "Nie udało się zapisać zmiany. Spróbuj ponownie.";
            await LoadAsync();
        }
        finally
        {
            busy.Remove(key);
        }
    }

    private void OpenEdit(UserWithPermissions user)
    {
        editing = user;
        editFirstName = user.FirstName;
        editLastName = user.LastName;
        editEmail = user.Email;
        editRole = user.Role;
        editError = null;
    }

    private void CancelEdit()
    {
        if (!saving) editing = null;
    }

    private async Task SaveEditAsync()
    {
        if (editing is null) return;

        var user = editing;
        saving = true;
        editError = null;
        try
        {
            await AuthService.UpdateUserAsync(user.UserId, editFirstName, editLastName, editEmail, editRole);
            user.FirstName = editFirstName.Trim();
            user.LastName = editLastName.Trim();
            user.Email = editEmail.Trim();
            user.Role = editRole;
            info = $"Zapisano dane użytkownika {user.DisplayName}.";
            error = null;
            editing = null;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            editError = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się zapisać danych użytkownika {UserId}.", user.UserId);
            editError = "Nie udało się zapisać zmian. Spróbuj ponownie.";
        }
        finally
        {
            saving = false;
        }
    }

    private void CancelAvatarRemoval()
    {
        if (!removingAvatar) pendingAvatarRemoval = null;
    }

    private async Task ConfirmAvatarRemovalAsync()
    {
        if (pendingAvatarRemoval is null) return;

        var user = pendingAvatarRemoval;
        removingAvatar = true;
        error = info = null;
        try
        {
            await AuthService.RemoveUserAvatarAsync(user.UserId);
            // zamiast zdjęcia od razu pojawiają się inicjały
            user.AvatarFileName = null;
            info = $"Usunięto zdjęcie profilowe użytkownika {user.DisplayName}.";
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            error = ex.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się usunąć zdjęcia profilowego użytkownika {UserId}.", user.UserId);
            error = "Nie udało się usunąć zdjęcia. Spróbuj ponownie.";
            await LoadAsync();
        }
        finally
        {
            removingAvatar = false;
            pendingAvatarRemoval = null;
        }
    }

    private void CancelDelete()
    {
        if (!deleting) pendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (pendingDelete is null) return;

        var user = pendingDelete;
        deleting = true;
        error = info = null;
        try
        {
            await PermissionService.DeleteUserAsync(user.UserId);
            users.Remove(user);
            info = $"Usunięto użytkownika {user.DisplayName}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            error = ex.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się usunąć użytkownika {UserId}.", user.UserId);
            error = "Nie udało się usunąć użytkownika. Spróbuj ponownie.";
            await LoadAsync();
        }
        finally
        {
            deleting = false;
            pendingDelete = null;
        }
    }

    private async Task GrantAllAsync(UserWithPermissions user)
    {
        error = info = null;
        try
        {
            foreach (var p in PermissionInfo.All.Where(p => !user.Permissions.Contains(p)))
            {
                await PermissionService.SetPermissionAsync(user.UserId, p, true);
                user.Permissions.Add(p);
            }
            info = $"Nadano wszystkie uprawnienia użytkownikowi {user.DisplayName}.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or InvalidOperationException)
        {
            error = ex.Message;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się nadać wszystkich uprawnień użytkownikowi {UserId}.", user.UserId);
            error = "Nie udało się zapisać zmiany. Spróbuj ponownie.";
            await LoadAsync();
        }
    }
}
