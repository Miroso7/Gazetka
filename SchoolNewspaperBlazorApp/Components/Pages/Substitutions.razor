@page "/zastepstwa"
@using System.Globalization
@using Microsoft.Extensions.Logging
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@implements IDisposable
@inject ISubstitutionService substitutionService
@inject ILogger<Substitutions> logger

<PageTitle>Zastępstwa · Portal szkolny</PageTitle>

<div class="section-head">
    <h1 class="section-title">Zastępstwa</h1>
    <p class="section-sub">Aktualne zastępstwa za nieobecnych nauczycieli</p>
</div>

<div class="subst-bar">
    <div class="subst-bar__day">
        <button type="button" class="icon-btn" aria-label="Poprzedni dzień" @onclick="() => ShiftDayAsync(-1)">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <div class="subst-bar__label" aria-live="polite">
            <span class="subst-bar__date">@DayLabel</span>
            @if (date == DateTime.Today)
            {
                <span class="subst-chip subst-chip--sub">Dziś</span>
            }
            else if (date == DateTime.Today.AddDays(1))
            {
                <span class="subst-chip subst-chip--sub">Jutro</span>
            }
        </div>
        <button type="button" class="icon-btn" aria-label="Następny dzień" @onclick="() => ShiftDayAsync(1)">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
        </button>
    </div>

    <div class="subst-bar__filters">
        <input type="date" class="select" aria-label="Wybierz dzień"
               value="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="OnDateChangedAsync" />
        <select class="select" aria-label="Filtruj po klasie" @bind="classFilter">
            <option value="">Wszystkie klasy</option>
            @foreach (var c in ClassOptions)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <select class="select" aria-label="Filtruj po nauczycielu" @bind="teacherFilter">
            <option value="">Wszyscy nauczyciele</option>
            @foreach (var t in TeacherOptions)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
        @if (date != DateTime.Today)
        {
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="TodayAsync">Dziś</button>
        }
        @if (date != DateTime.Today.AddDays(1))
        {
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="TomorrowAsync">Jutro</button>
        }
    </div>
</div>

@if (searching)
{
    <div class="search-chip" role="status">
        <svg class="search-chip__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <span class="search-chip__text">Szukana fraza: <strong>@searchTerm</strong></span>
        <a class="search-chip__clear" href="/zastepstwa">Wyczyść</a>
    </div>
}

@if (loading)
{
    <div class="skel-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
}
else
{
    var shown = Filtered.ToList();
    if (shown.Count == 0)
    {
        <div class="empty-state">
            @(items.Count == 0 ? "Na ten dzień nie ma zastępstw." : searching ? $"Brak zastępstw pasujących do „{searchTerm}”." : "Brak zastępstw pasujących do filtrów.")
        </div>
    }
    else
    {
        <SubstitutionTable Items="shown" />
        <p class="subst-count">Zastępstw: @shown.Count</p>
    }
}

@code {
    private static readonly CultureInfo Pl = new("pl-PL");

    private DateTime date = DateTime.Today;
    private List<Substitution> items = new();
    private bool loading = true;
    private string classFilter = "";
    private string teacherFilter = "";

    // fraza z wyszukiwarki w nagłówku (/zastepstwa?q=kowalski); szukamy w zastępstwach wybranego dnia
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    private string searchTerm = "";
    private string[] searchWords = Array.Empty<string>();
    private bool searching => searchTerm.Length > 0;

    protected override void OnParametersSet()
    {
        searchTerm = SearchText.Clean(SearchQuery);
        searchWords = SearchText.Words(searchTerm);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // silent = odświeżenie w tle: bez szkieletu ładowania, żeby lista nie migała co minutę
    private async Task LoadAsync(bool silent = false)
    {
        if (!silent) loading = true;
        try
        {
            var requested = date;
            var loaded = await substitutionService.GetSubstitutionsAsync(requested);
            // użytkownik zmienił dzień w trakcie odświeżania w tle: stare dane nie mogą nadpisać nowych
            if (silent && requested != date) return;

            items = loaded;
            // filtr z poprzedniego dnia nie może ukryć wszystkich wpisów nowego dnia
            if (!ClassOptions.Any(c => c.Id.ToString() == classFilter)) classFilter = "";
            if (!TeacherOptions.Any(t => t.Id.ToString() == teacherFilter)) teacherFilter = "";
        }
        finally
        {
            loading = false;
        }
    }

    // zastępstwa odświeżają się same co minutę (nowe wpisy pojawiają się bez przeładowania strony)
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMinutes(1);
    private CancellationTokenSource? refreshCts;

    // OnAfterRender działa dopiero w otwartym obwodzie (nie przy prerenderze), więc timer startuje raz
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        refreshCts = new CancellationTokenSource();
        _ = RefreshLoopAsync(refreshCts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync(silent: true);
                        StateHasChanged();
                    });
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // kolejna próba za minutę, a tabela zostaje taka, jaka była
                    logger.LogWarning(ex, "Nie udało się odświeżyć zastępstw.");
                }
            }
        }
        catch (OperationCanceledException)
        {
            // strona została zamknięta
        }
    }

    public void Dispose()
    {
        refreshCts?.Cancel();
        refreshCts?.Dispose();
    }

    private async Task ShiftDayAsync(int days)
    {
        date = date.AddDays(days);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        date = DateTime.Today;
        await LoadAsync();
    }

    private async Task TomorrowAsync()
    {
        date = DateTime.Today.AddDays(1);
        await LoadAsync();
    }

    private async Task OnDateChangedAsync(ChangeEventArgs e)
    {
        if (DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            date = parsed;
            await LoadAsync();
        }
    }

    // opcje filtrów pochodzą z zastępstw wybranego dnia
    private IEnumerable<SchoolClass> ClassOptions => items
        .Where(s => s.Class != null)
        .Select(s => s.Class!)
        .DistinctBy(c => c.Id)
        .OrderBy(c => c.Name, StringComparer.CurrentCultureIgnoreCase);

    private IEnumerable<Teacher> TeacherOptions => items
        .SelectMany(s => new[] { s.AbsentTeacher, s.SubstituteTeacher })
        .Where(t => t != null)
        .Select(t => t!)
        .DistinctBy(t => t.Id)
        .OrderBy(t => t.Name, StringComparer.CurrentCultureIgnoreCase);

    private IEnumerable<Substitution> Filtered
    {
        get
        {
            var q = items.AsEnumerable();
            if (!string.IsNullOrEmpty(classFilter))
            {
                q = q.Where(s => s.ClassId.ToString() == classFilter);
            }
            if (!string.IsNullOrEmpty(teacherFilter))
            {
                q = q.Where(s => s.AbsentTeacherId.ToString() == teacherFilter || s.SubstituteTeacherId.ToString() == teacherFilter);
            }
            if (searching)
            {
                q = q.Where(s => SearchText.MatchesAll(searchWords, Haystack(s)));
            }
            return q;
        }
    }

    // pola przeszukiwane wyszukiwarką: lekcja, klasa, przedmiot, nauczyciele, sala, uwagi i odwołanie
    private static string Haystack(Substitution s) =>
        $"{s.Lesson} {s.Class?.Name} {s.Subject?.Name} {s.AbsentTeacher?.Name} {s.SubstituteTeacher?.Name} {s.Room?.Name} {s.Note} {(s.IsCancelled ? "odwołana" : "")}";

    private string DayLabel
    {
        get
        {
            var text = date.ToString("dddd, d MMMM yyyy", Pl);
            return text.Length == 0 ? text : char.ToUpper(text[0], Pl) + text[1..];
        }
    }
}
