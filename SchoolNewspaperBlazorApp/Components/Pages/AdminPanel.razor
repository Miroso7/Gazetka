@page "/adminPanel"
@attribute [Authorize(Policy = AuthConstants.FullAccessPolicy)]
@inject IArticleService articleService
@inject IFileService fileService
@inject IPermissionService permissionService
@inject NavigationManager Navigation
@inject NotificationService Notify
@inject ILogger<AdminPanel> logger
@using Microsoft.Extensions.Logging
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service


@if (!authorized)
{
    @* sprawdzanie sesji (localStorage jest dostępny dopiero po prerenderze) *@
    <div class="admin">
        <div class="panel" style="grid-column: 1 / -1;">
            <div class="skel-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
        </div>
    </div>
}
else
{
    <div class="admin">

        <aside class="admin-side">
            <div class="admin-side__head">
                <span class="admin-side__title">Panel redakcji</span>
                <span class="admin-side__sub">Gazetka szkolna</span>
            </div>
            <nav class="admin-side__nav" aria-label="Sekcje panelu">
                <button class="admin-nav__item @Active(0)" aria-current="@(view == 0 ? "page" : null)" @onclick="() => SetView(0)">
                    @Icon("grid") <span>Przegląd</span>
                </button>
                <button class="admin-nav__item @Active(1)" aria-current="@(view == 1 ? "page" : null)" @onclick="LoadArticleAsync">
                    @Icon("list") <span>Artykuły</span>
                    <span class="admin-nav__badge">@articleList.Count</span>
                </button>
                @if (Can(EnumPermissions.AddArticle))
                {
                    <button class="admin-nav__item @Active(2)" aria-current="@(view == 2 ? "page" : null)" @onclick="OpenAdd">
                        @Icon("plus") <span>Dodaj artykuł</span>
                    </button>
                }
                @if (Can(EnumPermissions.DeleteArticle))
                {
                    <button class="admin-nav__item @Active(8)" aria-current="@(view == 8 ? "page" : null)" @onclick="OpenTrashAsync">
                        @Icon("trash") <span>Kosz</span>
                        @if (deletedList.Count > 0)
                        {
                            <span class="admin-nav__badge">@deletedList.Count</span>
                        }
                    </button>
                }
                @if (CanSubstitutions)
                {
                    <button class="admin-nav__item @Active(6)" aria-current="@(view == 6 ? "page" : null)" @onclick="() => SetView(6)">
                        @Icon("calendar") <span>Zastępstwa</span>
                    </button>
                }
                @if (Can(EnumPermissions.ManageSchoolData))
                {
                    <button class="admin-nav__item @Active(7)" aria-current="@(view == 7 ? "page" : null)" @onclick="() => SetView(7)">
                        @Icon("layers") <span>Dane szkoły</span>
                    </button>
                }
                @if (Can(EnumPermissions.AddUser))
                {
                    <button class="admin-nav__item @Active(3)" aria-current="@(view == 3 ? "page" : null)" @onclick="() => SetView(3)">
                        @Icon("user-plus") <span>Dodaj użytkownika</span>
                    </button>
                }
                @if (Can(EnumPermissions.ManageUser))
                {
                    <button class="admin-nav__item @Active(4)" aria-current="@(view == 4 ? "page" : null)" @onclick="() => SetView(4)">
                        @Icon("shield") <span>Uprawnienia</span>
                    </button>
                }
                <button class="admin-nav__item @Active(5)" aria-current="@(view == 5 ? "page" : null)" @onclick="() => SetView(5)">
                    @Icon("user") <span>Moje konto</span>
                </button>
                <form method="post" action="/auth/logout" style="display: contents;">
                    <AntiforgeryToken />
                    <button type="submit" class="admin-nav__item">
                        @Icon("logout") <span>Wyloguj</span>
                    </button>
                </form>
            </nav>
        </aside>

        <section class="admin-main">

            <header class="admin-head">
                <h1 class="admin-head__title">@ViewTitle</h1>
                <p class="admin-head__sub">@ViewSub</p>
            </header>

            @if (view == 0)
            {
                if (myPermissions.Count == 0)
                {
                    <div class="panel" style="margin-bottom: 1rem;">
                        <div class="empty-state">Twoje konto nie ma jeszcze żadnych uprawnień. Poproś administratora o ich nadanie.</div>
                    </div>
                }

                <div class="stats">
                    <div class="stat">
                        <span class="stat__icon">@Icon("file")</span>
                        <div><div class="stat__value">@(loading ? "–" : articleList.Count(a => !a.IsDraft))</div><div class="stat__label">Artykułów</div></div>
                    </div>
                    <div class="stat">
                        <span class="stat__icon">@Icon("eye")</span>
                        <div><div class="stat__value">@(loading ? "–" : articleList.Sum(a => (long)a.ViewCount))</div><div class="stat__label">Wyświetleń</div></div>
                    </div>
                    <div class="stat">
                        <span class="stat__icon">@Icon("users")</span>
                        <div><div class="stat__value">@(loading ? "–" : Authors.Count())</div><div class="stat__label">Autorów</div></div>
                    </div>
                    <div class="stat">
                        <span class="stat__icon">@Icon("image")</span>
                        <div><div class="stat__value">@(loading ? "–" : articleList.Count(a => imageUrls.ContainsKey(a.FileId)))</div><div class="stat__label">Ze zdjęciem</div></div>
                    </div>
                </div>

                <div class="qa-grid">
                    <button class="qa" @onclick="LoadArticleAsync">
                        <span class="qa__icon">@Icon("list")</span>
                        <span class="qa__title">Panel artykułów</span>
                        <span class="qa__text">Przeglądaj, wyszukuj, edytuj i usuwaj artykuły.</span>
                    </button>
                    @if (Can(EnumPermissions.AddArticle))
                    {
                        <button class="qa" @onclick="OpenAdd">
                            <span class="qa__icon">@Icon("plus")</span>
                            <span class="qa__title">Dodaj artykuł</span>
                            <span class="qa__text">Napisz nowy artykuł i dodaj zdjęcie.</span>
                        </button>
                    }
                    @if (CanSubstitutions)
                    {
                        <button class="qa" @onclick="() => SetView(6)">
                            <span class="qa__icon">@Icon("calendar")</span>
                            <span class="qa__title">Zastępstwa</span>
                            <span class="qa__text">Dodawaj i edytuj zastępstwa za nieobecnych nauczycieli.</span>
                        </button>
                    }
                    @if (Can(EnumPermissions.ManageSchoolData))
                    {
                        <button class="qa" @onclick="() => SetView(7)">
                            <span class="qa__icon">@Icon("layers")</span>
                            <span class="qa__title">Dane szkoły</span>
                            <span class="qa__text">Klasy, nauczyciele, sale i przedmioty do zastępstw.</span>
                        </button>
                    }
                    @if (Can(EnumPermissions.AddUser))
                    {
                        <button class="qa" @onclick="() => SetView(3)">
                            <span class="qa__icon">@Icon("user-plus")</span>
                            <span class="qa__title">Dodaj użytkownika</span>
                            <span class="qa__text">Utwórz nowego użytkownika w systemie.</span>
                        </button>
                    }
                    @if (Can(EnumPermissions.ManageUser))
                    {
                        <button class="qa" @onclick="() => SetView(4)">
                            <span class="qa__icon">@Icon("shield")</span>
                            <span class="qa__title">Uprawnienia</span>
                            <span class="qa__text">Nadawaj i odbieraj uprawnienia użytkownikom.</span>
                        </button>
                    }
                </div>

                <div class="panel">
                    <div class="panel__head">
                        <h2 class="panel__title">Ostatnio dodane</h2>
                        <button class="link-btn" @onclick="LoadArticleAsync">Zobacz wszystkie</button>
                    </div>
                    @if (loading)
                    {
                        <div class="skel-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
                    }
                    else if (articleList.Count == 0)
                    {
                        <div class="empty-state">Nie ma jeszcze żadnych artykułów.</div>
                    }
                    else
                    {
                        <ul class="recent">
                            @foreach (var a in articleList.OrderByDescending(x => x.Id).Take(5))
                            {
                                <li @key="a.Id">
                                    <a href="/article/@a.Id" class="recent__title">@TitleOf(a)</a>
                                    <span class="recent__author">@a.Author</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            else if (view == 1)
            {
                <div class="panel">
                    <div class="a-toolbar">
                        <div class="field">
                            <span class="field__icon">@Icon("search")</span>
                            <input class="field__input" type="search" placeholder="Szukaj w artykułach..."
                                   aria-label="Szukaj w artykułach"
                                   @bind="search" @bind:event="oninput" />
                        </div>
                        <select class="select" aria-label="Filtruj po autorze" @bind="authorFilter">
                            <option value="">Wszyscy autorzy</option>
                            @foreach (var author in Authors)
                            {
                                <option value="@author">@author</option>
                            }
                        </select>
                        <select class="select" aria-label="Filtruj po kategorii" @bind="typeFilter">
                            <option value="">Wszystkie kategorie</option>
                            @foreach (var option in Enum.GetValues<ArticleType>())
                            {
                                <option value="@option">@option.Label()</option>
                            }
                        </select>
                        <select class="select" aria-label="Filtruj po statusie" @bind="statusFilter">
                            <option value="">Wszystkie statusy</option>
                            <option value="published">Opublikowane</option>
                            <option value="draft">Wersje robocze</option>
                        </select>
                        <select class="select" aria-label="Sortowanie" @bind="sort">
                            <option value="newest">Najnowsze</option>
                            <option value="oldest">Najstarsze</option>
                            <option value="views">Najczęściej czytane</option>
                            <option value="title">Tytuł A–Z</option>
                        </select>
                    </div>

                    @if (loading)
                    {
                        <div class="skel-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
                    }
                    else
                    {
                        var items = Filtered.ToList();
                        if (items.Count == 0)
                        {
                            <div class="empty-state">
                                @(articleList.Count == 0 ? "Nie ma jeszcze żadnych artykułów." : "Brak artykułów pasujących do filtrów.")
                            </div>
                        }
                        else
                        {
                            <ul class="a-list">
                                @foreach (var a in items)
                                {
                                    <li class="a-row" @key="a.Id">
                                        <div class="a-row__thumb">
                                            @if (imageUrls.TryGetValue(a.FileId, out var url))
                                            {
                                                <img src="@url" alt="@TitleOf(a)" loading="lazy" />
                                            }
                                            else
                                            {
                                                @Icon("image")
                                            }
                                        </div>
                                        <div class="a-row__main">
                                            <h3 class="a-row__title">@TitleOf(a)</h3>
                                            <p class="a-row__text">@ArticleBodyMarkers.StripMarkers(a.Text)</p>
                                            <span class="a-row__author">@a.Author</span>
                                            <span class="type-chip type-chip--@a.Type.CssName()">@a.Type.Label()</span>
                                            @if (a.IsDraft)
                                            {
                                                <span class="state-chip state-chip--draft" title="Wersja robocza: niewidoczna dla czytelników, dopóki jej nie opublikujesz">Wersja robocza</span>
                                            }
                                            @if (a.IsPinned)
                                            {
                                                <span class="state-chip state-chip--pinned" title="Artykuł jest przypięty na górze listy">Przypięty</span>
                                            }
                                            @if (!a.IsDraft)
                                            {
                                                <span class="state-chip state-chip--views" title="Liczba wyświetleń artykułu">@Icon("eye") @a.ViewCount</span>
                                            }
                                            @if (!a.IsDraft && a.PublishDate > DateTime.Now)
                                            {
                                                <span class="state-chip state-chip--from" title="Zaplanowana publikacja: do tego czasu artykuł widzi tylko redakcja">Od @StateDate(a.PublishDate)</span>
                                            }
                                            @if (!a.IsDraft && a.ExpiresAt is { } expires)
                                            {
                                                if (expires <= DateTime.Now)
                                                {
                                                    <span class="state-chip state-chip--expired" title="Artykuł zniknął z listy i wyszukiwarki, ale link nadal działa">Wygasł @StateDate(expires)</span>
                                                }
                                                else
                                                {
                                                    <span class="state-chip state-chip--until" title="Po tej dacie artykuł zniknie z listy i wyszukiwarki">Do @StateDate(expires)</span>
                                                }
                                            }
                                        </div>
                                        <div class="a-row__actions">
                                            <a class="icon-btn" href="/article/@a.Id" target="_blank" rel="noopener"
                                               title="Podgląd" aria-label="Podgląd artykułu @TitleOf(a)">@Icon("external")</a>
                                            @if (CanEditArticle(a))
                                            {
                                                <button class="icon-btn" title="@(a.IsDraft ? "Edytuj wersję roboczą" : "Edytuj")"
                                                        aria-label="Edytuj artykuł @TitleOf(a)"
                                                        @onclick="() => StartEdit(a)">
                                                    @Icon("edit")
                                                </button>
                                            }
                                            @if (Can(EnumPermissions.DeleteArticle))
                                            {
                                                <button class="icon-btn icon-btn--danger" title="Usuń"
                                                        aria-label="Usuń artykuł @TitleOf(a)"
                                                        @onclick="() => pendingDelete = a">
                                                    @Icon("trash")
                                                </button>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="a-foot">Wyświetlono @items.Count z @articleList.Count</div>
                        }
                    }
                </div>
            }
            else if (view == 2 && (editingArticle is null ? Can(EnumPermissions.AddArticle) : Can(EnumPermissions.EditArticle)))
            {
                <ArticleForm @key="(editingArticle?.Id ?? 0)" ArticleToEdit="editingArticle"
                             OnAdded="ArticleAddedAsync" OnEdited="FinishEditAsync" OnCancelled="CancelEdit" />
            }
            else if (view == 8 && Can(EnumPermissions.DeleteArticle))
            {
                <div class="panel">
                    @if (trashLoading)
                    {
                        <div class="skel-list"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
                    }
                    else if (deletedList.Count == 0)
                    {
                        <div class="empty-state">Kosz jest pusty. Usunięte artykuły pojawią się tutaj i będzie można je przywrócić.</div>
                    }
                    else
                    {
                        <ul class="a-list">
                            @foreach (var a in deletedList)
                            {
                                <li class="a-row a-row--deleted" @key="a.Id">
                                    <div class="a-row__thumb">
                                        @if (imageUrls.TryGetValue(a.FileId, out var url))
                                        {
                                            <img src="@url" alt="@TitleOf(a)" loading="lazy" />
                                        }
                                        else
                                        {
                                            @Icon("image")
                                        }
                                    </div>
                                    <div class="a-row__main">
                                        <h3 class="a-row__title">@TitleOf(a)</h3>
                                        <p class="a-row__text">@ArticleBodyMarkers.StripMarkers(a.Text)</p>
                                        <span class="a-row__author">@a.Author</span>
                                        <span class="type-chip type-chip--@a.Type.CssName()">@a.Type.Label()</span>
                                        @if (a.IsDraft)
                                        {
                                            <span class="state-chip state-chip--draft">Wersja robocza</span>
                                        }
                                        @if (a.DeletedAt is { } deletedAt)
                                        {
                                            <span class="state-chip state-chip--expired" title="Moment usunięcia">Usunięto @StateDate(deletedAt.ToLocalTime())</span>
                                        }
                                    </div>
                                    <div class="a-row__actions">
                                        <button class="btn btn-sm btn-primary" @onclick="() => RestoreAsync(a)"
                                                disabled="@(restoringId != 0)"
                                                aria-label="Przywróć artykuł @TitleOf(a)">
                                            @(restoringId == a.Id ? "Przywracanie..." : "Przywróć")
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => pendingPurge = a"
                                                disabled="@(restoringId != 0)"
                                                aria-label="Usuń trwale artykuł @TitleOf(a)">
                                            Usuń trwale
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>
                        <div class="a-foot">W koszu: @deletedList.Count</div>
                    }
                </div>
            }
            else if (view == 3 && Can(EnumPermissions.AddUser))
            {
                <AddUserForm />
            }
            else if (view == 4 && Can(EnumPermissions.ManageUser))
            {
                <PermissionManager OnChanged="PermissionsChangedAsync" />
            }
            else if (view == 5)
            {
                <MyAccountForm />
            }
            else if (view == 6 && CanSubstitutions)
            {
                <SubstitutionManager CanAdd="Can(EnumPermissions.AddSubstitution)"
                                     CanEdit="Can(EnumPermissions.EditSubstitution)"
                                     CanDelete="Can(EnumPermissions.DeleteSubstitution)" />
            }
            else if (view == 7 && Can(EnumPermissions.ManageSchoolData))
            {
                <SchoolDataManager />
            }

        </section>
    </div>
}

@if (pendingPurge != null)
{
    <div class="confirm">
        <div class="confirm__scrim" @onclick="CancelPurge"></div>
        <div class="confirm__dialog" role="dialog" aria-modal="true" aria-labelledby="purge-title">
            <div class="confirm__icon">@Icon("trash")</div>
            <h2 id="purge-title" class="confirm__title">Usunąć trwale?</h2>
            <p class="confirm__text">Artykuł „@TitleOf(pendingPurge)” zostanie usunięty na stałe razem z galerią. Tego nie da się cofnąć.</p>
            <div class="confirm__actions">
                <button class="btn btn-outline-primary" @onclick="CancelPurge" disabled="@purging">Anuluj</button>
                <button class="btn btn-danger-solid" @onclick="ConfirmPurgeAsync" disabled="@purging">
                    @(purging ? "Usuwanie..." : "Usuń trwale")
                </button>
            </div>
        </div>
    </div>
}

@if (pendingDelete != null)
{
    <div class="confirm">
        <div class="confirm__scrim" @onclick="CancelDelete"></div>
        <div class="confirm__dialog" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
            <div class="confirm__icon">@Icon("trash")</div>
            <h2 id="confirm-title" class="confirm__title">Usunąć artykuł?</h2>
            <p class="confirm__text">Artykuł „@TitleOf(pendingDelete)” przestanie być widoczny. Trafi do kosza, skąd możesz go przywrócić.</p>
            <div class="confirm__actions">
                <button class="btn btn-outline-primary" @onclick="CancelDelete" disabled="@deleting">Anuluj</button>
                <button class="btn btn-danger-solid" @onclick="ConfirmDeleteAsync" disabled="@deleting">
                    @(deleting ? "Usuwanie..." : "Usuń")
                </button>
            </div>
        </div>
    </div>
}


@code {

    public int view = 0;
    public List<Article> articleList = new List<Article>();

    // parametr z adresu ustawiany przez stronę logowania (/adminPanel?zalogowano=1)
    [SupplyParameterFromQuery(Name = "zalogowano")]
    public string? LoggedInFlag { get; set; }

    // parametr z adresu ustawiany po zmianie hasła (/adminPanel?haslo=1)
    [SupplyParameterFromQuery(Name = "haslo")]
    public string? PasswordChangedFlag { get; set; }

    private readonly Dictionary<int, string> imageUrls = new();
    private bool loading = true;
    private bool deleting;
    private Article? pendingDelete;
    private Article? editingArticle;

    private string search = "";
    private string authorFilter = "";
    private string typeFilter = "";
    private string sort = "newest";
    private string statusFilter = "";

    // kosz: usunięte artykuły (miękkie usunięcie) do przywrócenia
    private List<Article> deletedList = new();
    private bool trashLoading;
    private int restoringId;
    private Article? pendingPurge;
    private bool purging;

    private bool authorized;

    // permisje zalogowanego użytkownika (z bazy) – decydują, co jest widoczne i dozwolone
    private HashSet<EnumPermissions> myPermissions = new();
    private bool Can(EnumPermissions permission) => myPermissions.Contains(permission);

    // zakładka „Zastępstwa” jest widoczna przy dowolnej permisji do zastępstw (przyciski zależą od konkretnej)
    private bool CanSubstitutions => Can(EnumPermissions.AddSubstitution)
        || Can(EnumPermissions.EditSubstitution)
        || Can(EnumPermissions.DeleteSubstitution);

    private async Task RefreshPermissionsAsync()
    {
        myPermissions = await permissionService.GetMyPermissionsAsync();
        // utrata uprawnienia nie może zostawić użytkownika w widoku, do którego już nie ma dostępu
        if (!CanOpenView(view))
        {
            editingArticle = null;
            view = 0;
        }
        StateHasChanged();
    }

    // wersję roboczą może edytować każdy, kto dodaje albo edytuje artykuły; opublikowany artykuł tylko ten, kto je edytuje
    private bool CanEditArticle(Article article) => article.IsDraft
        ? Can(EnumPermissions.AddArticle) || Can(EnumPermissions.EditArticle)
        : Can(EnumPermissions.EditArticle);

    // wersja robocza bez tytułu też musi mieć nazwę na liście
    private static string TitleOf(Article article) => string.IsNullOrWhiteSpace(article.Title) ? "(bez tytułu)" : article.Title;

    private bool CanOpenView(int v) => v switch
    {
        2 => editingArticle is null ? Can(EnumPermissions.AddArticle) : CanEditArticle(editingArticle),
        8 => Can(EnumPermissions.DeleteArticle),
        3 => Can(EnumPermissions.AddUser),
        4 => Can(EnumPermissions.ManageUser),
        6 => CanSubstitutions,
        7 => Can(EnumPermissions.ManageSchoolData),
        _ => true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // dane ładujemy dopiero po starcie obwodu (bez podwójnego ładowania przy prerenderze)
        myPermissions = await permissionService.GetMyPermissionsAsync();
        await RefreshAsync();
        authorized = true;
        StateHasChanged();

        if (LoggedInFlag == "1")
        {
            _ = ShowToastAsync("Zalogowano pomyślnie.");
            // czyścimy adres, żeby po odświeżeniu strony komunikat nie wracał
            Navigation.NavigateTo("/adminPanel", replace: true);
        }
        else if (PasswordChangedFlag == "1")
        {
            _ = ShowToastAsync("Hasło zostało zmienione.");
            Navigation.NavigateTo("/adminPanel", replace: true);
        }
    }

    public void SetView(int view)
    {
        if (!CanOpenView(view)) return;
        this.view = view;
    }

    private void OpenAdd()
    {
        if (!Can(EnumPermissions.AddArticle)) return;
        editingArticle = null;
        view = 2;
    }

    private void StartEdit(Article article)
    {
        if (!CanEditArticle(article)) return;
        editingArticle = article;
        view = 2;
    }

    private void CancelEdit()
    {
        editingArticle = null;
        view = 1;
    }

    private async Task FinishEditAsync()
    {
        await RefreshAsync();
        editingArticle = null;
        view = 1;
        _ = ShowToastAsync("Zmiany zostały zapisane.");
    }

    private async Task OpenTrashAsync()
    {
        SetView(8);
        await LoadDeletedAsync();
    }

    // kosz ładujemy tylko osobom z uprawnieniem do usuwania (te same osoby mogą przywracać)
    private async Task LoadDeletedAsync()
    {
        if (!Can(EnumPermissions.DeleteArticle))
        {
            deletedList = new();
            return;
        }

        trashLoading = true;
        try
        {
            deletedList = await articleService.GetDeletedArticlesAsync();

            var names = await fileService.GetFileNamesByIdsAsync(deletedList.Select(a => a.FileId));
            foreach (var (id, name) in names)
            {
                if (!string.IsNullOrWhiteSpace(name))
                {
                    imageUrls[id] = $"/Images/{name}";
                }
            }
        }
        catch (UnauthorizedAccessException)
        {
            deletedList = new();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Nie udało się wczytać kosza.");
            _ = ShowToastAsync("Nie udało się wczytać kosza.", true);
        }
        finally
        {
            trashLoading = false;
        }
    }

    private async Task RestoreAsync(Article article)
    {
        if (restoringId != 0) return;
        restoringId = article.Id;
        try
        {
            await articleService.RestoreArticleAsync(article.Id);
            deletedList.Remove(article);
            await RefreshAsync();
            _ = ShowToastAsync("Artykuł został przywrócony.");
        }
        catch (UnauthorizedAccessException)
        {
            _ = ShowToastAsync("Nie masz uprawnienia do przywracania artykułów.", true);
        }
        catch (InvalidOperationException ex)
        {
            _ = ShowToastAsync(ex.Message, true);
            await LoadDeletedAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Nie udało się przywrócić artykułu {ArticleId}.", article.Id);
            _ = ShowToastAsync("Nie udało się przywrócić artykułu.", true);
        }
        finally
        {
            restoringId = 0;
        }
    }

    private void CancelPurge()
    {
        if (!purging) pendingPurge = null;
    }

    // trwałe usunięcie z kosza: to samo uprawnienie co zwykłe usuwanie artykułów
    private async Task ConfirmPurgeAsync()
    {
        if (pendingPurge is null) return;
        var article = pendingPurge;
        if (!Can(EnumPermissions.DeleteArticle))
        {
            pendingPurge = null;
            _ = ShowToastAsync("Nie masz uprawnienia do usuwania artykułów.", true);
            return;
        }

        purging = true;
        try
        {
            await articleService.PurgeArticleAsync(article.Id);
            deletedList.Remove(article);
            pendingPurge = null;
            _ = ShowToastAsync("Artykuł został usunięty trwale.");
        }
        catch (UnauthorizedAccessException)
        {
            pendingPurge = null;
            _ = ShowToastAsync("Nie masz uprawnienia do usuwania artykułów.", true);
        }
        catch (InvalidOperationException ex)
        {
            pendingPurge = null;
            _ = ShowToastAsync(ex.Message, true);
            await LoadDeletedAsync();
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Nie udało się trwale usunąć artykułu {ArticleId}.", article.Id);
            _ = ShowToastAsync("Nie udało się usunąć artykułu.", true);
        }
        finally
        {
            purging = false;
        }
    }

    public async Task LoadArticleAsync()
    {
        SetView(1);              // widok od razu, ze szkieletem ładowania
        await RefreshAsync();
    }

    private async Task ArticleAddedAsync()
    {
        await RefreshAsync();
        _ = ShowToastAsync("Dodano artykuł.");
    }

    private async Task PermissionsChangedAsync()
    {
        await RefreshPermissionsAsync();
        _ = ShowToastAsync("Zapisano zmiany w uprawnieniach.");
    }

    private async Task RefreshAsync()
    {
        loading = true;
        try
        {
            articleList = await articleService.GetAllArticlesAsync();
            imageUrls.Clear();

            var names = await fileService.GetFileNamesByIdsAsync(articleList.Select(a => a.FileId));
            foreach (var (id, name) in names)
            {
                if (!string.IsNullOrWhiteSpace(name))
                {
                    imageUrls[id] = $"/Images/{name}";
                }
            }

            await LoadDeletedAsync();
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<string> Authors => articleList
        .Select(a => a.Author)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s, StringComparer.CurrentCultureIgnoreCase);

    private IEnumerable<Article> Filtered
    {
        get
        {
            var q = articleList.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(search))
            {
                q = q.Where(a => Has(a.Title, search) || Has(a.Author, search) || Has(a.Text, search));
            }
            if (statusFilter == "draft")
            {
                q = q.Where(a => a.IsDraft);
            }
            else if (statusFilter == "published")
            {
                q = q.Where(a => !a.IsDraft);
            }
            if (!string.IsNullOrEmpty(authorFilter))
            {
                q = q.Where(a => string.Equals(a.Author, authorFilter, StringComparison.OrdinalIgnoreCase));
            }
            if (Enum.TryParse<ArticleType>(typeFilter, out var type))
            {
                q = q.Where(a => a.Type == type);
            }
            return sort switch
            {
                "oldest" => q.OrderBy(a => a.Id),
                "views" => q.OrderByDescending(a => a.ViewCount).ThenByDescending(a => a.Id),
                "title" => q.OrderBy(a => a.Title, StringComparer.CurrentCultureIgnoreCase),
                _ => q.OrderByDescending(a => a.Id)
            };
        }
    }

    // data i godzina w znacznikach stanu artykułu
    private static string StateDate(DateTime value) => value.ToString("dd.MM.yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private static bool Has(string? source, string query) =>
        source?.Contains(query, StringComparison.CurrentCultureIgnoreCase) ?? false;

    private void CancelDelete()
    {
        if (!deleting) pendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (pendingDelete is null) return;
        if (!Can(EnumPermissions.DeleteArticle))
        {
            pendingDelete = null;
            _ = ShowToastAsync("Nie masz uprawnienia do usuwania artykułów.", true);
            return;
        }
        var article = pendingDelete;
        deleting = true;
        try
        {
            await articleService.RemoveArticleByIdAsync(article.Id);
            articleList.Remove(article);
            pendingDelete = null;
            await LoadDeletedAsync();
            _ = ShowToastAsync("Artykuł został przeniesiony do kosza.");
        }
        catch (UnauthorizedAccessException)
        {
            pendingDelete = null;
            _ = ShowToastAsync("Nie masz uprawnienia do usuwania artykułów.", true);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Nie udało się usunąć artykułu {ArticleId}.", article.Id);
            _ = ShowToastAsync("Nie udało się usunąć artykułu.", true);
        }
        finally
        {
            deleting = false;
        }
    }

    private Task ShowToastAsync(string message, bool error = false)
    {
        Notify.Show(message, error ? NotificationType.Error : NotificationType.Success);
        return Task.CompletedTask;
    }

