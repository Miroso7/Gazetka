@page "/article/{Id:int}"

@using System.Globalization
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService ArticleService
@inject IFileService FileService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<ArticlePage> Logger

<PageTitle>@(article is null ? "Artykuł" : $"{article.Title} · Portal szkolny")</PageTitle>

@if (article is not null)
{
    <HeadContent>
        <meta name="description" content="@Excerpt" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content="@article.Title" />
        <meta property="og:description" content="@Excerpt" />
        <meta property="article:author" content="@article.Author" />
        @if (imageUrl is not null)
        {
            <meta property="og:image" content="@Navigation.ToAbsoluteUri(imageUrl)" />
        }
    </HeadContent>

    <div class="ap-progress" aria-hidden="true"></div>
}

<nav class="ap-nav" aria-label="Nawigacja okruszkowa">
    <a class="ap-back" href="/">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
        Wszystkie artykuły
    </a>
</nav>

@if (isLoading)
{
    <div class="ap ap--loading" aria-busy="true" aria-live="polite">
        <div class="skel ap-skel ap-skel--title"></div>
        <div class="skel ap-skel ap-skel--meta"></div>
        <div class="skel ap-skel ap-skel--img"></div>
        <div class="skel ap-skel ap-skel--line"></div>
        <div class="skel ap-skel ap-skel--line"></div>
        <div class="skel ap-skel ap-skel--line ap-skel--short"></div>
    </div>
}
else if (loadFailed)
{
    <div class="ap-state" role="alert">
        <div class="ap-state__icon ap-state__icon--danger">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" /></svg>
        </div>
        <h1 class="ap-state__title">Nie udało się wczytać artykułu</h1>
        <p class="ap-state__text">Sprawdź połączenie i spróbuj ponownie.</p>
        <button type="button" class="btn btn-primary" @onclick="LoadAsync">Spróbuj ponownie</button>
    </div>
}
else if (article is null)
{
    <div class="ap-state">
        <div class="ap-state__icon">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
        </div>
        <h1 class="ap-state__title">Nie znaleziono artykułu</h1>
        <p class="ap-state__text">Ten artykuł mógł zostać usunięty lub link jest nieprawidłowy.</p>
        <a class="btn btn-primary" href="/">Wróć do strony głównej</a>
    </div>
}
else
{
    <article class="ap">
        <header class="ap-head">
            <span class="ap-kicker">@article.Type.Label()</span>
            <h1 class="ap-title">@article.Title</h1>

            <div class="ap-meta">
                <AuthorAvatar Name="@article.Author" Url="@authorAvatarUrl" Class="ap-avatar" />
                <div class="ap-meta__text">
                    <span class="ap-meta__author">@article.Author</span>
                    <span class="ap-meta__sub">
                        <time datetime="@(article.PublishDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))">@(article.PublishDate.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture))</time>
                        · @ReadingMinutes min czytania · @WordCount słów
                    </span>
                </div>

                <div class="ap-actions">
                    @* kopiowanie działa w przeglądarce od razu po jednym kliknięciu (app.js, data-copy-link), bez drogi przez serwer *@
                    <button type="button" class="ap-copy" data-copy-link
                            aria-label="Kopiuj link do artykułu" title="Kopiuj link do tego artykułu do schowka">
                        <svg class="ico ap-copy__ico ap-copy__ico--link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" /><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" /></svg>
                        <svg class="ico ap-copy__ico ap-copy__ico--ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                        <span class="ap-copy__label" aria-live="polite">Kopiuj link</span>
                    </button>
                </div>
            </div>
        </header>

        @if (imageUrl is not null)
        {
            <figure class="ap-figure">
                <img src="@imageUrl" alt="@article.Title" class="ap-figure__img" fetchpriority="high" decoding="async" />
            </figure>
        }

        @if (Details.Count > 0)
        {
            <dl class="ap-details">
                @foreach (var (label, value) in Details)
                {
                    <div class="ap-details__item">
                        <dt>@label</dt>
                        <dd>@value</dd>
                    </div>
                }
            </dl>
        }

        <ArticleBody Text="@article.Text" Photos="bodyPhotos" Title="@article.Title" />

        <ArticleGallery Images="remainingGalleryImages" Title="@article.Title" />

        <footer class="ap-foot">
            <div class="ap-foot__author">
                <AuthorAvatar Name="@article.Author" Url="@authorAvatarUrl" Class="ap-avatar ap-avatar--lg" />
                <div>
                    <span class="ap-foot__label">Autor artykułu</span>
                    <strong class="ap-foot__name">@article.Author</strong>
                </div>
            </div>
            <div class="ap-foot__links">
                @if (!string.IsNullOrWhiteSpace(article.Author))
                {
                    <a class="btn btn-outline-primary" href="@($"/?autor={Uri.EscapeDataString(article.Author.Trim())}#aktualnosci")">Więcej artykułów autora →</a>
                }
                else
                {
                    @* bez podpisu autora nie ma czyjej listy pokazać, więc zostaje ogólny link *@
                    <a class="btn btn-outline-primary" href="/">Więcej artykułów →</a>
                }
            </div>
        </footer>
    </article>
}

@code {
    [Parameter] public int Id { get; set; }

    private Article? article;
    private string? imageUrl;
    // zdjęcie profilowe autora (null = podpis pokaże inicjały)
    private string? authorAvatarUrl;
    private List<ArticleImageDto> galleryImages = new();
    // zdjęcia ułożone w treści nie powtarzają się w galerii pod artykułem
    private List<ArticleImageDto> remainingGalleryImages = new();
    private List<ArticleBodyPhoto> bodyPhotos = new();
    private bool isLoading = true;
    private bool loadFailed;
    private int loadedId = -1;
    private int countedId;

    private IReadOnlyList<string> Paragraphs { get; set; } = Array.Empty<string>();
    private int WordCount { get; set; }
    private int ReadingMinutes => Math.Max(1, (int)Math.Ceiling(WordCount / 200.0));
    // pola zależne od typu artykułu (data, miejsce itp.) wypełnione w formularzu
    private List<(string Label, string Value)> Details => article is null ? new() : ArticleFields.Display(article);

    private string Excerpt
    {
        get
        {
            var flat = string.Join(' ', Paragraphs);
            return flat.Length <= 160 ? flat : flat[..157].TrimEnd() + "…";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // wyświetlenie liczymy dopiero po wyrenderowaniu w przeglądarce (prerender nie nabija licznika); serwis liczy artykuł raz na sesję
        if (article is null || article.IsDraft || article.Id == countedId) return;
        countedId = article.Id;
        await ArticleService.RegisterViewAsync(article.Id);
    }

    protected override async Task OnParametersSetAsync()
    {
        // przeładuj tylko, gdy zmieni się Id (np. nawigacja z jednego artykułu do drugiego)
        if (Id == loadedId) return;
        loadedId = Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;
        article = null;
        imageUrl = null;
        authorAvatarUrl = null;
        galleryImages = new();
        remainingGalleryImages = new();
        bodyPhotos = new();

        try
        {
            // null = artykuł zaplanowany, którego czytelnik jeszcze nie może zobaczyć (strona pokaże „Nie znaleziono artykułu”)
            article = await ArticleService.GetArticleByIdAsync(Id);

            if (article is not null)
            {
                galleryImages = await ArticleService.GetArticleImagesAsync(article.Id);

                var fileName = await FileService.GetFileNameByIdAsync(article.FileId);
                if (!string.IsNullOrWhiteSpace(fileName))
                {
                    imageUrl = $"/Images/{Uri.EscapeDataString(fileName)}";
                }

                try
                {
                    var avatars = await AuthService.GetAuthorAvatarUrlsAsync(new[] { article.Author });
                    authorAvatarUrl = avatars.TryGetValue(article.Author, out var avatarUrl) ? avatarUrl : null;
                }
                catch (Exception ex)
                {
                    // bez zdjęcia profilowego artykuł nadal się wyświetla (w podpisie są inicjały)
                    Logger.LogWarning(ex, "Nie udało się wczytać zdjęcia profilowego autora artykułu {ArticleId}.", article.Id);
                }

                bodyPhotos = galleryImages.Select(i => new ArticleBodyPhoto(i.Url, i.Placement, i.InlineAfter)).ToList();
                var blocks = ArticleBodyMarkers.Layout(article.Text, bodyPhotos);
                var used = blocks.Where(b => b.Photo is not null).Select(b => b.Photo!.Value).ToHashSet();
                remainingGalleryImages = galleryImages
                    .Where((_, index) => !used.Contains(index))
                    .ToList();

                // zdjęcia nie wchodzą do opisu strony ani do liczby słów
                Paragraphs = blocks.Where(b => b.Text is not null).Select(b => b.Text!).ToList();
                WordCount = Paragraphs.Sum(p => p.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się wczytać artykułu {ArticleId}.", Id);
            loadFailed = true;
        }
        finally
        {
            isLoading = false;
        }
    }

}
