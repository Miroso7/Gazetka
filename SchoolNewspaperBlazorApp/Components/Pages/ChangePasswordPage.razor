@page "/change-password"
@attribute [Authorize]
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthState

<div class="auth">

    <aside class="auth__aside">
        <span class="auth__badge">Bezpieczeństwo konta</span>
        <h2 class="auth__aside-title">Ustaw własne hasło</h2>
        <p class="auth__aside-text">Tylko Ty powinieneś znać hasło do swojego konta w gazetce.</p>
        <ul class="auth__list">
            <li>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                Co najmniej @PasswordPolicy.MinLength znaków
            </li>
            <li>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                Najlepiej zdanie lub kilka niezwiązanych słów
            </li>
            <li>
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>
                Hasło używane tylko w tym miejscu
            </li>
        </ul>
    </aside>

    <section class="auth__panel">
        @if (!forced)
        {
            <a class="auth__back" href="/adminPanel">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
                Wróć do panelu
            </a>
        }

        <h1 class="auth__title">Zmiana hasła</h1>
        <p class="auth__sub">Po zmianie zostaniesz zalogowany na nowo, a inne sesje tego konta zostaną zakończone.</p>

        @if (forced)
        {
            <div class="auth-info" role="status">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                <span>Zanim wejdziesz do panelu, ustaw własne hasło w miejsce tymczasowego.</span>
            </div>
        }

        @if (ErrorResult is { } error)
        {
            <div class="auth-alert" role="alert">
                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                <span>@error.Message()</span>
            </div>
        }

        @* Zwykły formularz HTML (jak logowanie): po zmianie hasła serwer wystawia nowe cookie, co wymaga żądania HTTP
           (endpoint /auth/change-password w Program.cs), a nie połączenia SignalR. Hasła nie przechodzą przez obwód Blazora. *@
        <form method="post" action="/auth/change-password" class="auth-form">
            <AntiforgeryToken />

            @foreach (var field in fields)
            {
                <div class="auth-field" @key="field.Id">
                    <label class="auth-field__label" for="@field.Id">@field.Label</label>
                    <div class="auth-field__control">
                        <svg class="ico auth-field__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        @* type="text" + maskowanie w CSS: przeglądarka nie dorysowuje własnego oka *@
                        <input id="@field.Id" name="@field.Name" class="auth-input"
                               style="@(shown.Contains(field.Id) ? null : "-webkit-text-security: disc;")"
                               type="text"
                               autocomplete="@field.Autocomplete" autocapitalize="off" spellcheck="false"
                               placeholder="@field.Placeholder" maxlength="@PasswordPolicy.MaxLength"
                               minlength="@field.MinLength" required />
                        <button type="button" class="auth-toggle" @onclick="() => Toggle(field.Id)"
                                aria-label="@(shown.Contains(field.Id) ? "Ukryj hasło" : "Pokaż hasło")"
                                aria-pressed="@shown.Contains(field.Id)">
                            @if (shown.Contains(field.Id))
                            {
                                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19M14.12 14.12a3 3 0 1 1-4.24-4.24M1 1l22 22" /></svg>
                            }
                            else
                            {
                                <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                            }
                        </button>
                    </div>
                    @if (field.Hint is not null)
                    {
                        <div class="auth-hint">@field.Hint</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-primary auth-submit">
                <span>Zmień hasło</span>
            </button>
        </form>

        @if (forced)
        {
            <form method="post" action="/auth/logout" class="auth-extra">
                <AntiforgeryToken />
                <button type="submit" class="link-btn">Wyloguj się</button>
            </form>
        }
    </section>
</div>

@code {
    private sealed record PasswordField(string Id, string Name, string Label, string Autocomplete, string Placeholder, int MinLength, string? Hint = null);

    private static readonly PasswordField[] fields =
    [
        new("current-password", "CurrentPassword", "Obecne hasło", "current-password", "Obecne hasło", 0),
        new("new-password", "NewPassword", "Nowe hasło", "new-password", "Nowe hasło", PasswordPolicy.MinLength,
            $"Minimum {PasswordPolicy.MinLength} znaków."),
        new("confirm-password", "ConfirmPassword", "Powtórz nowe hasło", "new-password", "Powtórz nowe hasło", PasswordPolicy.MinLength)
    ];

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    // true, gdy konto musi zmienić hasło (wtedy nie ma powrotu do panelu bez zmiany)
    private bool forced;
    private readonly HashSet<string> shown = new();

    // Tylko znane powody odmowy; tekst komunikatu pochodzi z kodu, nigdy z adresu.
    private ChangePasswordResult? ErrorResult =>
        Enum.TryParse<ChangePasswordResult>(Error, true, out var result)
        && Enum.IsDefined(result)
        && result != ChangePasswordResult.Success
            ? result
            : null;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        forced = state.User.HasClaim(c => c.Type == AuthConstants.MustChangePasswordClaim);
    }

    private void Toggle(string id)
    {
        if (!shown.Remove(id))
        {
            shown.Add(id);
        }
    }
}
