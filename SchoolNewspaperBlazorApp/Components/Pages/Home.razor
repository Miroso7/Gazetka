@page "/"
@using System.Text.RegularExpressions
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService

<section class="hero">
    <div class="hero__content">
        <span class="hero__badge">Gazetka Elitarnego Technikum Informatycznego</span>
        <h1 class="hero__title">Wszystko, co dzieje się w <span class="hero__accent">naszej szkole</span></h1>
        <p class="hero__lead">
            Aktualności, wydarzenia i artykuły uczniów w jednym miejscu.
            Sprawdź, co nowego w świecie technologii i życia szkoły.
        </p>
        <div class="hero__actions">
            <a class="btn btn-white hero__cta" href="#aktualnosci">
                Czytaj aktualności
                <svg class="hero__cta-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
            </a>
        </div>
    </div>

    <aside class="hero__panel" aria-label="Skróty do kategorii">
        <span class="hero__panel-title">Zacznij od…</span>
        <ul class="hero__links">
            @for (var i = 0; i < heroTypes.Length; i++)
            {
                var heroType = heroTypes[i];
                <li style="--n:@i">
                    <a class="hero__link" href="@($"/?typ={heroType}#aktualnosci")">
                        <span class="hero__link-ico" aria-hidden="true">
                            @switch (heroType)
                            {
                                case ArticleType.Events:
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18" /></svg>
                                    break;
                                case ArticleType.Announcements:
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a1 1 0 0 0 1 1h3l5 4V6L7 10H4a1 1 0 0 0-1 1Z" /><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" /></svg>
                                    break;
                                default:
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2" /><path d="M18 14h-8M15 18h-5M10 6h8v4h-8V6Z" /></svg>
                                    break;
                            }
                        </span>
                        <span class="hero__link-text">
                            <strong>@heroType.Label()</strong>
                            <small>@heroType.Description()</small>
                        </span>
                        <svg class="hero__link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                    </a>
                </li>
            }
        </ul>
        <a class="hero__panel-more" href="/#aktualnosci">
            Wszystkie artykuły
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
    </aside>
</section>

<section class="news-zone">
    <div class="section-head" id="aktualnosci">
        <h2 class="section-title">@(searching ? "Wyniki wyszukiwania" : selectedType?.Label() ?? "Aktualności")</h2>
        <p class="section-sub">@(searching ? ResultsSummary() : selectedType?.Description() ?? "Najnowsze artykuły z życia szkoły")</p>
    </div>

    <nav class="type-tabs" aria-label="Kategorie artykułów">
        <div class="type-tabs__list">
            <a class="type-tab @(selectedType is null ? "is-active" : "")" href="@BuildHref(null, searching)"
               aria-current="@(selectedType is null ? "page" : null)">Wszystkie</a>
            @foreach (var type in ArticleTypeExtensions.Selectable())
            {
                <a class="type-tab @(selectedType == type ? "is-active" : "")" href="@BuildHref(type, searching)"
                   aria-current="@(selectedType == type ? "page" : null)">@type.Label()</a>
            }
        </div>
    </nav>

    @if (searching)
    {
        <div class="search-chip" role="status">
            <svg class="search-chip__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
            <span class="search-chip__text">Szukana fraza: <strong>@searchTerm</strong></span>
            <a class="search-chip__clear" href="@BuildHref(selectedType, false)">Wyczyść</a>
        </div>
    }

    @if (articles.Count > PageSizes[0])
    {
        <div class="pager-bar">
            <span class="pager-bar__info">@RangeSummary()</span>
            <div class="pager-size" role="group" aria-label="Liczba artykułów na stronie">
                <span class="pager-size__label">Na stronie:</span>
                @foreach (var size in PageSizes)
                {
                    <a class="pager-size__item @(size == pageSize ? "is-active" : "")" href="@BuildHref(selectedType, searching, 1, size)"
                       aria-current="@(size == pageSize ? "true" : null)">@size</a>
                }
            </div>
        </div>
    }

    <ArticleCard Articles="pageArticles"
                 permissions="false"
                 FirstPage="@(page == 1)"
                 ShowType="@(selectedType is null)"
                 EmptyText="@EmptyMessage" />

    @if (totalPages > 1)
    {
        <nav class="pager" aria-label="Strony artykułów">
            @if (page > 1)
            {
                <a class="pager__item pager__item--nav" href="@BuildHref(selectedType, searching, page - 1)" rel="prev">← Poprzednia</a>
            }
            else
            {
                <span class="pager__item pager__item--nav is-disabled" aria-disabled="true">← Poprzednia</span>
            }

            @foreach (var p in PageNumbers())
            {
                if (p == 0)
                {
                    <span class="pager__gap" aria-hidden="true">…</span>
                }
                else
                {
                    <a class="pager__item @(p == page ? "is-active" : "")" href="@BuildHref(selectedType, searching, p)"
                       aria-label="Strona @p" aria-current="@(p == page ? "page" : null)">@p</a>
                }
            }

            @if (page < totalPages)
            {
                <a class="pager__item pager__item--nav" href="@BuildHref(selectedType, searching, page + 1)" rel="next">Następna →</a>
            }
            else
            {
                <span class="pager__item pager__item--nav is-disabled" aria-disabled="true">Następna →</span>
            }
        </nav>
    }
</section>


@code
{
    // wybrana zakładka, np. /?typ=Events (brak = wszystkie artykuły)
    [SupplyParameterFromQuery(Name = "typ")]
    public string? TypeQuery { get; set; }

    // fraza z wyszukiwarki w nagłówku, np. /?q=zawody (szukamy w tytule, treści i autorze)
    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchQuery { get; set; }

    // numer strony i liczba artykułów na stronie, np. /?strona=2&na=20 (brak = pierwsza strona, 10 artykułów)
    [SupplyParameterFromQuery(Name = "strona")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "na")]
    public int? PageSizeQuery { get; set; }

    // wszystkie artykuły pasujące do kategorii i frazy
    public List<Article> articles = new List<Article>();

    // artykuły widoczne na bieżącej stronie
    private List<Article> pageArticles = new();

    private static readonly int[] PageSizes = { 5, 10, 20 };
    private const int DefaultPageSize = 10;

    private int pageSize = DefaultPageSize;
    private int page = 1;
    private int totalPages = 1;

    private ArticleType? selectedType;
    private string searchTerm = "";
    private bool searching => searchTerm.Length > 0;

    private static readonly Regex PhotoMarker = new(@"\[foto:\d+\]", RegexOptions.Compiled);

    // skróty w sekcji powitalnej
    private static readonly ArticleType[] heroTypes = { ArticleType.News, ArticleType.Events, ArticleType.Announcements };

    protected override async Task OnParametersSetAsync()
    {
        selectedType = Enum.TryParse<ArticleType>(TypeQuery, true, out var type) && Enum.IsDefined(type) && type != ArticleType.Substitute
            ? type
            : null;

        var source = selectedType is { } t
            ? await articleService.GetArticlesByTypeAsync(t)
            : await articleService.GetAllArticlesAsync();

        searchTerm = SearchText.Clean(SearchQuery);

        articles = searching ? Filter(source, searchTerm) : source;

        pageSize = PageSizeQuery is { } size && PageSizes.Contains(size) ? size : DefaultPageSize;
        totalPages = Math.Max(1, (int)Math.Ceiling(articles.Count / (double)pageSize));
        page = Math.Clamp(PageQuery ?? 1, 1, totalPages);
        pageArticles = articles.Skip((page - 1) * pageSize).Take(pageSize).ToList();
    }

    // wszystkie słowa z frazy muszą wystąpić w tytule, treści lub autorze (bez rozróżniania wielkości liter i polskich znaków)
    private static List<Article> Filter(List<Article> source, string term)
    {
        var words = SearchText.Words(term);

        return source
            .Where(a => SearchText.MatchesAll(words, $"{a.Title} {a.Author} {PhotoMarker.Replace(a.Text ?? "", " ")}"))
            .ToList();
    }

    // adres zakładki; withSearch zachowuje frazę, żeby dało się zawęzić wyniki do kategorii
    // zmiana zakładki lub frazy wraca na pierwszą stronę, ale zachowuje wybraną liczbę artykułów na stronie
    private string BuildHref(ArticleType? type, bool withSearch, int targetPage = 1, int? size = null)
    {
        var parts = new List<string>();
        if (type is { } t) parts.Add($"typ={t}");
        if (withSearch && searching) parts.Add($"q={Uri.EscapeDataString(searchTerm)}");
        var targetSize = size ?? pageSize;
        if (targetSize != DefaultPageSize) parts.Add($"na={targetSize}");
        if (targetPage > 1) parts.Add($"strona={targetPage}");

        return "/" + (parts.Count > 0 ? "?" + string.Join("&", parts) : "") + "#aktualnosci";
    }

    private string ResultsSummary()
    {
        var n = articles.Count;
        var few = n % 10 is >= 2 and <= 4 && n % 100 is not (>= 12 and <= 14);
        var word = n == 1 ? "wynik" : few ? "wyniki" : "wyników";
        var scope = selectedType is { } t ? $" w kategorii {t.Label()}" : "";
        return $"{n} {word}{scope}";
    }

    // numery stron do pokazania (0 = przerwa „…”): pierwsza, ostatnia i najbliższe bieżącej
    private IEnumerable<int> PageNumbers()
    {
        var last = 0;
        for (var p = 1; p <= totalPages; p++)
        {
            if (p != 1 && p != totalPages && Math.Abs(p - page) > 1) continue;

            if (last != 0 && p - last > 1) yield return 0;
            yield return p;
            last = p;
        }
    }

    private string RangeSummary()
    {
        var from = (page - 1) * pageSize + 1;
        var to = Math.Min(page * pageSize, articles.Count);
        return $"Artykuły {from}–{to} z {articles.Count}";
    }

    private string EmptyMessage => searching
        ? $"Brak wyników dla „{searchTerm}”. Spróbuj innych słów kluczowych."
        : selectedType?.EmptyText() ?? "Nie ma jeszcze żadnych artykułów.";
}
